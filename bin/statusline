  priorityColors
};

// packages/core/dist/renderers/cli.js
var CliRenderer = class {
  target = "cli";
  render(layout, ctx) {
    const sectionSeparator = this.getSectionSeparator(ctx);
    return this.renderSections(layout, ctx, sectionSeparator);
  }
  measureItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return content.replace(/\x1b\[[0-9;]*m/g, "").length;
  }
  renderItem(item, ctx) {
    return this.resolveContent(item, ctx);
  }
  join(items, separator) {
    return items.join(separator);
  }
  getItemSeparator(ctx) {
    return style.dim(" | ");
  }
  getSectionSeparator(ctx) {
    return style.dim(" | ");
  }
  /**
   * Render section items with separators.
   */
  renderSectionItems(section, ctx) {
    return section.items.map((item) => this.renderItem(item, ctx));
  }
  /**
   * Render all sections with section separators.
   */
  renderSections(layout, ctx, sectionSeparator) {
    const renderedSections = layout.sections.map((section) => {
      const items = this.renderSectionItems(section, ctx);
      if (items.length === 0)
        return null;
      const itemSeparator = this.getItemSeparator(ctx);
      return this.join(items, itemSeparator);
    }).filter((s) => s !== null);
    return this.join(renderedSections, sectionSeparator);
  }
  /**
   * Resolve item content to string.
   */
  resolveContent(item, ctx) {
    if (typeof item.content === "string") {
      return item.content;
    }
    if (typeof item.content === "function") {
      return item.content(ctx);
    }
    if ("template" in item.content) {
      const { template, values, fallback } = item.content;
      try {
        return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? fallback ?? ""));
      } catch {
        return fallback ?? "";
      }
    }
    if ("parts" in item.content) {
      return item.content.parts.map((p) => p.text).join("");
    }
    return "";
  }
};
var cliRenderer = new CliRenderer();

// packages/core/dist/renderers/vscode.js
var VSCodeRenderer = class {
  target = "vscode";
  render(layout, ctx) {
    const items = [];
    for (let i = 0; i < layout.sections.length; i++) {
      const section = layout.sections[i];
      for (let j = 0; j < section.items.length; j++) {
        const item = section.items[j];
        const rendered = this.renderItem(item, ctx);
        if (rendered) {
          items.push(rendered);
        }
      }
      if (i < layout.sections.length - 1) {
        items.push(this.getSectionSeparatorItem());
      }
    }
    return items;
  }
  measureItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return content.length;
  }
  renderItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return {
      text: content,
      tooltip: this.getTooltip(item, ctx),
      color: this.getItemColor(item),
      priority: this.getItemPriority(item)
    };
  }
  join(items, separator) {
    if (items.length === 0)
      return [];
    if (items.length === 1)
      return items;
    const result = [items[0]];
    for (let i = 1; i < items.length; i++) {
      result.push(separator);
      result.push(items[i]);
    }
    return result;
  }
  resolveContent(item, ctx) {
    if (typeof item.content === "string") {
      return item.content;
    }
    if (typeof item.content === "function") {
      return item.content(ctx);
    }
    if ("template" in item.content) {
      const { template, values, fallback } = item.content;
      try {
        return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? fallback ?? ""));
      } catch {
        return fallback ?? "";
      }
    }
    if ("parts" in item.content) {
      return item.content.parts.map((p) => p.text).join("");
    }
    return "";
  }
  getTooltip(item, ctx) {
    return `${item.id}: ${this.resolveContent(item, ctx)}`;
  }
  getItemColor(item) {
    if (item.priority >= 100)
      return "var(--statusBarItem.errorBackground)";
    if (item.priority >= 70)
      return "var(--statusBarItem.warningBackground)";
    return void 0;
  }
  getItemPriority(item) {
    return 100 - item.priority / 100 * 50;
  }
  getSectionSeparatorItem() {
    return {
      text: "$(dash)",
      color: "var(--statusBarItem.remoteBackground)"
    };
  }
};
var vscodeRenderer = new VSCodeRenderer();

// packages/core/dist/renderers/neovim.js
var NeovimRenderer = class {
  target = "neovim";
  render(layout, ctx) {
    const components = [];
    for (let i = 0; i < layout.sections.length; i++) {
      const section = layout.sections[i];
      for (let j = 0; j < section.items.length; j++) {
        const item = section.items[j];
        const component = this.renderItem(item, ctx);
        if (component) {
          if (j > 0) {
            components.push(this.getItemSeparatorComponent());
          }
          components.push(component);
        }
      }
      if (i < layout.sections.length - 1) {
        components.push(this.getSectionSeparatorComponent());
      }
    }
    return components;
  }
  measureItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return content.length;
  }
  renderItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return {
      provider: content,
      hl: this.getHighlightGroup(item),
      separator: { right: "" }
    };
  }
  join(items, separator) {
    if (items.length === 0)
      return [];
    if (items.length === 1)
      return items;
    const result = [items[0]];
    for (let i = 1; i < items.length; i++) {
      result.push(separator);
      result.push(items[i]);
    }
    return result;
  }
  resolveContent(item, ctx) {
    if (typeof item.content === "string") {
      return item.content;
    }
    if (typeof item.content === "function") {
      return item.content(ctx);
    }
    if ("template" in item.content) {
      const { template, values, fallback } = item.content;
      try {
        return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? fallback ?? ""));
      } catch {
        return fallback ?? "";
      }
    }
    if ("parts" in item.content) {
      return item.content.parts.map((p) => p.text).join("");
    }
    return "";
  }
  getHighlightGroup(item) {
    if (item.priority >= 100)
      return "StatusLineCritical";
    if (item.priority >= 70)
      return "StatusLineHigh";
    if (item.priority >= 30)
      return "StatusLineMedium";
    if (item.priority >= 10)
      return "StatusLineLow";
    return "StatusLineNone";
  }
  getItemSeparatorComponent() {
    return {
      provider: "\u2502",
      hl: "StatusLineSeparator"
    };
  }
  getSectionSeparatorComponent() {
    return {
      provider: "\u2502",
      hl: "StatusLineSectionSeparator"
    };
  }
};
var neovimRenderer = new NeovimRenderer();

// packages/core/dist/renderers/opencode.js
var OpenCodeRenderer = class {
  target = "opencode";
  render(layout, ctx) {
    const components = [];
    for (let i = 0; i < layout.sections.length; i++) {
      const section = layout.sections[i];
      for (let j = 0; j < section.items.length; j++) {
        const item = section.items[j];
        const component = this.renderItem(item, ctx);
        if (component) {
          if (j > 0) {
            components.push(this.getItemSeparatorComponent());
          }
          components.push(component);
        }
      }
      if (i < layout.sections.length - 1) {
        components.push(this.getSectionSeparatorComponent());
      }
    }
    return components;
  }
  measureItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return content.length;
  }
  renderItem(item, ctx) {
    const content = this.resolveContent(item, ctx);
    return {
      type: "text",
      content,
      style: this.getStyle(item.priority),
      color: this.getColor(item.priority)
    };
  }
  join(items, separator) {
    if (items.length === 0)
      return [];
    if (items.length === 1)
      return items;
    const result = [items[0]];
    for (let i = 1; i < items.length; i++) {
      result.push(separator);
      result.push(items[i]);
    }
    return result;
  }
  resolveContent(item, ctx) {
    if (typeof item.content === "string") {
      return item.content;
    }
    if (typeof item.content === "function") {
      return item.content(ctx);
    }
    if ("template" in item.content) {
      const { template, values, fallback } = item.content;
      try {
        return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? fallback ?? ""));
      } catch {
        return fallback ?? "";
      }
    }
    if ("parts" in item.content) {
      return item.content.parts.map((p) => p.text).join("");
    }
    return "";
  }
  getStyle(priority) {
    if (priority >= 100)
      return "bold";
    if (priority >= 70)
      return "normal";
    if (priority >= 30)
      return "normal";
    if (priority >= 10)
      return "dim";
    return "dim";
  }
  getColor(priority) {
    if (priority >= 100)
      return "#ff6b6b";
    if (priority >= 70)
      return "#ffd93d";
    if (priority >= 30)
      return "#ffffff";
    if (priority >= 10)
      return "#a0a0a0";
    return "#606060";
  }
  getItemSeparatorComponent() {
    return {
      type: "separator",
      content: "\u2502",
      style: "dim",
      color: "#606060"
    };
  }
  getSectionSeparatorComponent() {
    return {
      type: "separator",
      content: "\u2502",
      style: "dim",
      color: "#808080"
    };
  }
};
var opencodeRenderer = new OpenCodeRenderer();

// dist/formatter.js
function adaptInputForCore(unified, prices) {
  const { model, context, usage: usage2, cost, cache, rateLimits, extensions } = unified;
  const overhead = calculateOverhead(unified, prices);
  const costMultiplier = matchModelPrice2(prices, model.displayName, "Claude Sonnet 5.5", extensions.fastMode === true);
  return {
    model: {
      name: model.displayName,
      effort: model.capabilities.effortLevel,
      costMultiplier: costMultiplier !== null && costMultiplier !== 1 ? costMultiplier : null,
      id: model.id
    },
    context: {
      percentage: context.usedPercentage,
      tokensUsed: (usage2.inputTokens ?? 0) + (usage2.outputTokens ?? 0),
      tokensTotal: context.maxTokens
    },
    cost: {
      session: cost.sessionCostUsd,
      total: cost.totalCostUsd
    },
    cache: cache.ttlSeconds !== null ? {
      status: cache.warm ? "warm" : "cold",
      hitRatio: cache.hitRatio,
      expiresAt: cache.expiresAt
    } : null,
    rateLimits: rateLimits.map((r) => ({
      window: r.id,
      limit: r.limit,
      remaining: r.limit !== null ? r.limit - r.limit * (r.usedPercentage ?? 0) / 100 : 0,
      resetsAt: r.resetsAt
    })),
    overhead,
    usage: {
      totalTokens: (usage2.inputTokens ?? 0) + (usage2.outputTokens ?? 0),
      cacheTokens: cache.recacheTokensIfCold
    },
    vim: extensions.vimMode ? { mode: extensions.vimMode } : null,
    worktree: extensions.worktree ? { name: extensions.worktree.name } : null,
    cursorExtensions: extensions.maxMode || extensions.paramSummary || extensions.autorun ? {
      maxMode: extensions.maxMode,
      paramSummary: extensions.paramSummary,
      autorun: extensions.autorun
    } : null
  };
}
function calculateOverhead(unified, prices) {
  const { cache, model, extensions } = unified;
  const ctoks = cache.recacheTokensIfCold;
  const freshTokens = 25e3;
  if (ctoks == null || cache.ttlSeconds == null || ctoks <= freshTokens) {
    return { show: false };
  }
  const modelPrices = prices.models[model.displayName] || prices.models[`Claude ${model.displayName}`] || prices.models[model.displayName.toLowerCase()] || prices.models[`claude ${model.displayName.toLowerCase()}`];
  if (!modelPrices) {
    return { show: false };
  }
  const pin = extensions.fastMode === true && modelPrices.fast_in ? modelPrices.fast_in : modelPrices.in;
  const pout = modelPrices.out;
  const wmul = cache.ttlSeconds === 3600 ? 2 : 1.25;
  const d = ctoks - freshTokens;
  const oCall = d * 0.1 * pin / 1e6;
  const oCold = d * wmul * pin / 1e6;
  const oBe = freshTokens * wmul / (d * 0.1);
  const summaryTokens = 8e3;
  const oCompact = (ctoks * 0.1 * pin + summaryTokens * pout + (freshTokens + summaryTokens) * wmul * pin) / 1e6;
  return {
    show: true,
    costPerCall: oCall,
    breakEven: Math.ceil(oBe) < 1 ? 1 : Math.ceil(oBe),
    compactCost: oCompact,
    isCold: !cache.warm,
    coldCost: oCold
  };
}
function buildUserConfig(options) {
  const config = {
    sections: {},
    items: {},
    priorityThreshold: PriorityLevel.NONE
  };
  if (options.sections) {
    const enabledSections = new Set(options.sections.split(",").map((s) => s.trim()));
    const sectionMap = {
      "model": "model",
      "context": "context",
      "tokens": "usage",
      "cost": "cost",
      "overhead": "overhead",
      "cache": "cache",
      "stats": "cache",
      // stats is part of cache (hit ratio)
      "resets": "rate-limits",
      "vim": "vim",
      "worktree": "worktree",
      "cursor-extensions": "cursor-extensions"
    };
    config.sections = config.sections || {};
    for (const [legacyName, newId] of Object.entries(sectionMap)) {
      const isEnabled = enabledSections.has(legacyName);
      if (isEnabled || !(newId in config.sections)) {
        config.sections[newId] = { enabled: isEnabled };
      }
    }
  }
  if (options.resets) {
    const enabledResets = new Set(options.resets.split(",").map((s) => s.trim()));
    config.sections = config.sections || {};
    config.sections["rate-limits"] = config.sections["rate-limits"] || { enabled: true };
    config.sections["rate-limits"].resets = Array.from(enabledResets);
  }
  if (options.contextWarn !== void 0)
    config.contextWarn = options.contextWarn;
  if (options.contextCrit !== void 0)
    config.contextCrit = options.contextCrit;
  if (options.cacheWarn !== void 0)
    config.cacheWarn = options.cacheWarn;
  if (options.cacheCrit !== void 0)
    config.cacheCrit = options.cacheCrit;
  if (options.resetWarn !== void 0)
    config.resetWarn = options.resetWarn;
  if (options.resetCrit !== void 0)
    config.resetCrit = options.resetCrit;
  if (options.overheadWarn !== void 0)
    config.overheadWarn = options.overheadWarn;
  if (options.overheadCrit !== void 0)
    config.overheadCrit = options.overheadCrit;
  return config;
}
async function formatStatusLine2(unified, options = {}) {
  const { width = 120, margin = 3, pricesTtl = 3600, claudeConfigDir } = options;
  const isWidthConstrained = width > 0;
  const effectiveWidth = width > 0 ? width : 120;
  const effectiveMargin = margin > 0 ? margin : 3;
  try {
    const prices = await loadPrices2(claudeConfigDir || "", pricesTtl);
    const adaptedInput = adaptInputForCore(unified, prices);
    const userConfig = buildUserConfig(options);
    const ctx = {
      input: adaptedInput,
      width: effectiveWidth - effectiveMargin,
      target: "cli",
      config: userConfig,
      // Pass whether width is constrained (for layout engine)
      widthConstrained: isWidthConstrained
    };
    const sections = getSections(userConfig, ctx);
    const layout = buildLayout(sections, ctx);
    const output = cliRenderer.render(layout, ctx);
    return output;
  } catch (error) {
    console.error("[statusline] New pipeline failed, falling back to legacy:", error);
    return formatStatusLine(unified, options);
  }
}
var DEFAULT_SECTION_CONFIGS = {
  "claude-code": [
    { name: "model", enabled: true, order: 1 },
    { name: "context", enabled: true, order: 2 },
    { name: "overhead", enabled: true, order: 3, visibleWhen: (input) => input.cache.ttlSeconds !== null && input.cache.recacheTokensIfCold !== null },
    { name: "tokens", enabled: false, order: 4 },
    { name: "cost", enabled: true, order: 5, visibleWhen: (input) => input.cost.sessionCostUsd !== null },
    { name: "cache", enabled: true, order: 6, visibleWhen: (input) => input.cache.ttlSeconds !== null },
    { name: "stats", enabled: false, order: 7, visibleWhen: (input) => input.cache.hitRatio !== null },
    { name: "resets", enabled: true, order: 8 }
  ],
  "cursor": [
    { name: "model", enabled: true, order: 1 },
    { name: "context", enabled: true, order: 2 },
    { name: "tokens", enabled: true, order: 3, visibleWhen: (input) => input.usage.inputTokens > 0 || input.usage.outputTokens > 0 },
    { name: "cost", enabled: false, order: 4, visibleWhen: (input) => input.cost.sessionCostUsd !== null },
    { name: "cache", enabled: false, order: 5 },
    { name: "stats", enabled: false, order: 6 },
    { name: "resets", enabled: false, order: 7 }
  ]
};
function buildSectionsString(agentType, customSections) {
  if (customSections)
    return customSections;
  const configs = DEFAULT_SECTION_CONFIGS[agentType] || DEFAULT_SECTION_CONFIGS["claude-code"];
  return configs.filter((c) => c.enabled).sort((a, b) => a.order - b.order).map((c) => c.name).join(",");
}

// dist/statusline.js
var __filename5 = fileURLToPath5(import.meta.url);
var __dirname5 = join6(__filename5, "..");
function getEnv(key) {
  return process.env[key];
}
function getClaudeConfigDirFromEnv() {
  return getEnv("CLAUDE_CONFIG_DIR") || join6(process.env.HOME || "~", ".claude");
}
async function loadSettings(claudeConfigDir) {
  const config = await loadConfig(claudeConfigDir);
  const get = (key, defaultValue) => {
    const envKey = `STATUSLINE_${key}`;
    const envVal = getEnv(envKey);
    if (envVal !== void 0)
      return envVal;
    const configVal = getSetting(config, key);
    if (configVal !== void 0)
      return configVal;
    return String(defaultValue);
  };
  const num = (key, defaultValue) => {
    const v = get(key, defaultValue);
    const parsed = parseInt(v, 10);
    return isNaN(parsed) ? defaultValue : parsed;
  };
  return {
    baseModel: get("BASE_MODEL", DEFAULT_BASE_MODEL),
    sections: get("SECTIONS", DEFAULT_SECTIONS),
    resets: get("RESETS", DEFAULT_RESETS),
    pricesTtl: num("PRICES_TTL", DEFAULT_PRICES_TTL),
    contextWarn: num("CONTEXT_WARN", DEFAULT_CONTEXT_WARN),
    contextCrit: num("CONTEXT_CRIT", DEFAULT_CONTEXT_CRIT),
    cacheWarn: num("CACHE_WARN", DEFAULT_CACHE_WARN),
    cacheCrit: num("CACHE_CRIT", DEFAULT_CACHE_CRIT),
    resetWarn: num("RESET_WARN", DEFAULT_RESET_WARN),
    resetCrit: num("RESET_CRIT", DEFAULT_RESET_CRIT),
    width: num("WIDTH", DEFAULT_WIDTH),
    margin: num("MARGIN", DEFAULT_MARGIN),
    dumpPath: get("DUMP", ""),
    freshTokens: num("FRESH_TOKENS", DEFAULT_FRESH_TOKENS),
    summaryTokens: num("SUMMARY_TOKENS", DEFAULT_SUMMARY_TOKENS),
    overheadWarn: num("OVERHEAD_WARN", DEFAULT_OVERHEAD_WARN),
    overheadCrit: num("OVERHEAD_CRIT", DEFAULT_OVERHEAD_CRIT)
  };
}
async function generateStatusLine(input) {
  const claudeConfigDir = getClaudeConfigDirFromEnv();
  const settings = await loadSettings(claudeConfigDir);
  let unifiedInput;
  try {
    const rawInput = JSON.parse(input);
    unifiedInput = adapterRegistry.parse(rawInput);
  } catch (error) {
    throw new Error(`Failed to parse input: ${error instanceof Error ? error.message : String(error)}`);
  }
  if (settings.dumpPath) {
    try {
      const { promises: fs7 } = await import("fs");
      await fs7.writeFile(settings.dumpPath, input);
    } catch {
    }
  }
  const pricesPath = join6(claudeConfigDir, "model-prices.json");
  try {
    const stat = await import("fs").then((fs7) => fs7.promises.stat(pricesPath));
    const age = Date.now() - stat.mtimeMs;
    if (age >= settings.pricesTtl * 1e3) {
      Promise.resolve().then(() => (init_refresh_prices(), refresh_prices_exports)).then(({ refreshPrices: refreshPrices2 }) => {
        refreshPrices2(claudeConfigDir, settings.pricesTtl).catch(() => {
        });
      });
    }
  } catch {
    Promise.resolve().then(() => (init_refresh_prices(), refresh_prices_exports)).then(({ refreshPrices: refreshPrices2 }) => {
      refreshPrices2(claudeConfigDir, settings.pricesTtl).catch(() => {
      });
    });
  }
  let sections = settings.sections;
  if (sections === DEFAULT_SECTIONS) {
    sections = buildSectionsString(unifiedInput.agent);
  }
  const line = await formatStatusLine2(unifiedInput, {
    width: settings.width,
    margin: settings.margin,
    sections,
    resets: settings.resets,
    contextWarn: settings.contextWarn,
    contextCrit: settings.contextCrit,
    cacheWarn: settings.cacheWarn,
    cacheCrit: settings.cacheCrit,
    resetWarn: settings.resetWarn,
    resetCrit: settings.resetCrit,
    freshTokens: settings.freshTokens,
    summaryTokens: settings.summaryTokens,
    overheadWarn: settings.overheadWarn,
    overheadCrit: settings.overheadCrit,
    baseModel: settings.baseModel,
    pricesTtl: settings.pricesTtl,
    dumpPath: settings.dumpPath,
    claudeConfigDir
  });
  const adapter = adapterRegistry.get(unifiedInput.agent);
  if (adapter?.formatOutput) {
    return adapter.formatOutput(line, unifiedInput.extensions);
  }
  return line;
}

// dist/config.js
init_constants();
import { fileURLToPath as fileURLToPath6 } from "url";
init_prices();

// src/utils/config-utils.ts
import { join as join7 } from "path";
function getClaudeConfigDir() {
  return process.env.CLAUDE_CONFIG_DIR || join7(process.env.HOME || "~", ".claude");
}

// dist/config.js
var __filename6 = fileURLToPath6(import.meta.url);
function parseArgs(argv) {
  if (argv.length === 0)
    return { command: "help", args: [] };
  return { command: argv[0], args: argv.slice(1) };
}
function usage() {
  console.log(`Usage: config <command>
  show                          current settings (value, and where it comes from)
  model [NAME|list]             base model for the price multiplier (x1.0); no NAME = show
  sections [list]               enabled/hidden sections and the valid names
  sections show|hide NAME...    enable/disable sections
  sections only NAME...         enable just these
  sections all                  enable all
      NAME: model context tokens cost overhead cache stats resets   (overhead = extra cost of continuing vs a fresh session; stats = always show the cache hit rate (default: only when below 80%))
  resets LIST|all|none          which reset windows to show, e.g. 5h,7d,spend
  thresholds context|resets WARN CRIT   yellow/red at WARN/CRIT percent used (0-100)
  thresholds cache WARN CRIT            yellow/red when WARN/CRIT minutes are left
  thresholds overhead WARN CRIT         yellow/red at WARN/CRIT extra cents per call vs a fresh session
  overhead [FRESH [SUMMARY]]    token sizes for the overhead metric: a fresh session (25000), a compaction summary (8000)
  width [N|auto]                terminal columns to fit the line into (auto = detect from the tty)
  margin N                      columns kept free at the right edge (default 2)
  dump [PATH|off]               write the raw status-line JSON + detected width/level to PATH on each run
  reset [KEY...]                drop saved settings (all if none given)
      KEY: BASE_MODEL SECTIONS RESETS CONTEXT_WARN CONTEXT_CRIT CACHE_WARN CACHE_CRIT RESET_WARN RESET_CRIT WIDTH MARGIN DUMP FRESH_TOKENS SUMMARY_TOKENS OVERHEAD_WARN OVERHEAD_CRIT`);
}
function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}
function isInt(s) {
  return /^\d+$/.test(s);
}
function currentSections(config) {
  const v = config.SECTIONS;
  return v ? v : ALL_SECTIONS.join(",");
}
function validSection(s) {
  return ALL_SECTIONS.includes(s);
}
async function cmdShow(claudeConfigDir) {
  const config = await loadConfig(claudeConfigDir);
  const pricesPath = getPricesPath(claudeConfigDir);
  const defaults = [
    ["BASE_MODEL", DEFAULT_BASE_MODEL],
    ["SECTIONS", DEFAULT_SECTIONS],
    ["RESETS", DEFAULT_RESETS],
    ["CONTEXT_WARN", String(DEFAULT_CONTEXT_WARN)],
    ["CONTEXT_CRIT", String(DEFAULT_CONTEXT_CRIT)],
    ["CACHE_WARN", String(DEFAULT_CACHE_WARN)],
    ["CACHE_CRIT", String(DEFAULT_CACHE_CRIT)],
    ["RESET_WARN", String(DEFAULT_RESET_WARN)],
    ["RESET_CRIT", String(DEFAULT_RESET_CRIT)],
    ["WIDTH", `${DEFAULT_WIDTH}(auto)`],
    ["MARGIN", String(DEFAULT_MARGIN)],
    ["FRESH_TOKENS", String(DEFAULT_FRESH_TOKENS)],
    ["SUMMARY_TOKENS", String(DEFAULT_SUMMARY_TOKENS)],
    ["OVERHEAD_WARN", String(DEFAULT_OVERHEAD_WARN)],
    ["OVERHEAD_CRIT", String(DEFAULT_OVERHEAD_CRIT)]
  ];
  console.log("setting         value                                    source");
  for (const [key, def] of defaults) {
    const envKey = `STATUSLINE_${key}`;
    let value;
    let source;
    if (process.env[envKey] !== void 0) {
      value = process.env[envKey];
      source = `env ${envKey}`;
    } else if (key in config) {
      value = config[key] ?? def;
      source = "saved";
    } else {
      value = def;
      source = "default";
    }
    console.log(`${key.padEnd(14)} ${value.padEnd(38)} ${source}`);
  }
  console.log(`file: ${getConfigPath(claudeConfigDir)}`);
}
async function cmdModel(claudeConfigDir, args) {
  const prices = await loadPrices(claudeConfigDir);
  const config = await loadConfig(claudeConfigDir);
  const pricesPath = getPricesPath(claudeConfigDir);
  if (args[0] === "list") {
    if (!prices.models || Object.keys(prices.models).length === 0) {
      die(`no price table yet (${pricesPath}); open a session and wait a moment, then retry`);
    }
    for (const [name, p] of Object.entries(prices.models)) {
      console.log(`${name}  (in $${p.in}/MTok)`);
    }
    return;
  }
  if (args.length === 0) {
    const v = config.BASE_MODEL;
    console.log(`base model: ${v || `${DEFAULT_BASE_MODEL} (default)`}`);
    return;
  }
  const want = args.join(" ");
  if (!prices.models || Object.keys(prices.models).length === 0) {
    die(`no price table yet (${pricesPath}); cannot validate '${want}'`);
  }
  const lowerWant = want.toLowerCase();
  let matched;
  for (const name of Object.keys(prices.models)) {
    const lowerName = name.toLowerCase();
    if (lowerName === lowerWant || lowerName === `claude ${lowerWant}`) {
      matched = name;
      break;
    }
  }
  if (!matched) {
    console.error(`error: unknown model '${want}'. Known:`);
    for (const name of Object.keys(prices.models)) {
      console.error(name);
    }
    process.exit(1);
  }
  await putSetting(claudeConfigDir, "BASE_MODEL", matched);
  console.log(`base model: ${matched}`);
}
function sectionsStatus(config) {
  const cur = currentSections(config).split(",");
  let hidden = "";
  for (const s of ALL_SECTIONS) {
    if (!cur.includes(s))
      hidden += ` ${s}`;
  }
  console.log(`enabled: ${cur.join(" ")}`);
  console.log(`hidden: ${hidden || " (none)"}`);
  console.log(`names:   ${ALL_SECTIONS.join(" ")}   (stats = always show the cache hit rate (default: only when below 80%))`);
  console.log(`change:  sections show|hide|only NAME...   or   sections all`);
}
async function saveSections(claudeConfigDir, enabled) {
  const config = await loadConfig(claudeConfigDir);
  const before = currentSections(config);
  const out = ALL_SECTIONS.filter((s) => enabled.includes(s)).join(",");
  if (!out)
    die("at least one section must stay enabled");
  await putSetting(claudeConfigDir, "SECTIONS", out);
  let hidden = "";
  for (const s of ALL_SECTIONS) {
    if (!enabled.includes(s))
      hidden += ` ${s}`;
  }
  if (before === out) {
    console.log(`no change (already: ${out})`);
  } else {
    console.log("sections updated");
  }
  console.log(`enabled: ${out.replace(/,/g, " ")}`);
  console.log(`hidden: ${hidden || " (none)"}`);
}
async function cmdSections(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  const cur = currentSections(config).split(",");
  if (args.length === 0 || args[0] === "list" || args[0] === "status") {
    sectionsStatus(config);
    return;
  }
  const sub = args[0];
  const names = args.slice(1);
  for (const n of names) {
    if (!validSection(n))
      die(`unknown section '${n}' (one of: ${ALL_SECTIONS.join(", ")})`);
  }
  switch (sub) {
    case "show":
      await saveSections(claudeConfigDir, [...cur, ...names]);
      break;
    case "only":
      await saveSections(claudeConfigDir, names);
      break;
    case "hide": {
      const remaining = cur.filter((s) => !names.includes(s));
      await saveSections(claudeConfigDir, remaining);
      break;
    }
    case "all":
      await dropSettings(claudeConfigDir, ["SECTIONS"]);
      console.log("sections: all enabled");
      break;
    default:
      die(`sections: expected show|hide|only NAME..., all or list, got '${sub}'`);
  }
}
async function cmdResets(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.RESETS;
    console.log(`resets: ${v || `${DEFAULT_RESETS} (default)`}`);
    return;
  }
  if (args.length !== 1)
    die("resets: one comma-separated list, e.g. 5h,7d,spend");
  const list = args[0];
  if (/[^A-Za-z0-9_,-]/.test(list))
    die("resets: use a comma list of window names, e.g. 5h,7d,spend");
  await putSetting(claudeConfigDir, "RESETS", list);
  console.log(`resets: ${list}`);
  console.log("only the windows named here are shown (default: 5h,7d,spend; spend exists only on gateway accounts). Undo: reset RESETS");
}
async function cmdThresholds(claudeConfigDir, args) {
  if (args.length < 3)
    die("thresholds: expected context|resets|cache|overhead WARN CRIT");
  const what = args[0];
  const warn = parseInt(args[1], 10);
  const crit = parseInt(args[2], 10);
  if (isNaN(warn) || isNaN(crit))
    die("thresholds: WARN and CRIT must be whole numbers");
  let pre;
  switch (what) {
    case "context":
      pre = "CONTEXT";
      if (!(warn < crit && crit <= 100))
        die("context: need WARN < CRIT <= 100");
      break;
    case "resets":
      pre = "RESET";
      if (!(warn < crit && crit <= 100))
        die("resets: need WARN < CRIT <= 100");
      break;
    case "cache":
      pre = "CACHE";
      if (!(crit < warn))
        die("cache: CRIT minutes must be lower than WARN (red comes later, as time runs out)");
      break;
    case "overhead":
      pre = "OVERHEAD";
      if (!(warn < crit))
        die("overhead: need WARN < CRIT (cents per call)");
      break;
    default:
      die("thresholds: expected context|resets|cache|overhead WARN CRIT");
  }
  await putSettings(claudeConfigDir, [
    [`${pre}_WARN`, String(warn)],
    [`${pre}_CRIT`, String(crit)]
  ]);
  const unit = what === "cache" ? " minutes left" : what === "overhead" ? " cents per call" : "%";
  console.log(`${what}: yellow at ${warn}, red at ${crit}${unit}`);
}
async function cmdWidth(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.WIDTH;
    console.log(`width: ${v || "auto"}`);
    return;
  }
  if (args[0] === "auto") {
    await dropSettings(claudeConfigDir, ["WIDTH"]);
    console.log("width: auto");
    return;
  }
  if (!isInt(args[0]) || parseInt(args[0], 10) <= 0)
    die("width: a positive number of columns, or auto");
  await putSetting(claudeConfigDir, "WIDTH", args[0]);
  console.log(`width: ${args[0]}`);
}
async function cmdMargin(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.MARGIN;
    console.log(`margin: ${v || `${DEFAULT_MARGIN} (default)`}`);
    return;
  }
  if (!isInt(args[0]))
    die("margin: a number of columns");
  await putSetting(claudeConfigDir, "MARGIN", args[0]);
  console.log(`margin: ${args[0]}`);
}
async function cmdOverhead(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const fresh = config.FRESH_TOKENS || String(DEFAULT_FRESH_TOKENS);
    const summary = config.SUMMARY_TOKENS || String(DEFAULT_SUMMARY_TOKENS);
    console.log(`overhead: fresh ${fresh} summary ${summary} (empty = default ${DEFAULT_FRESH_TOKENS} / ${DEFAULT_SUMMARY_TOKENS})`);
    return;
  }
  if (!isInt(args[0]) || parseInt(args[0], 10) <= 0)
    die("overhead: FRESH must be a positive token count");
  const entries = [["FRESH_TOKENS", args[0]]];
  if (args[1]) {
    if (!isInt(args[1]) || parseInt(args[1], 10) <= 0)
      die("overhead: SUMMARY must be a positive token count");
    entries.push(["SUMMARY_TOKENS", args[1]]);
  }
  await putSettings(claudeConfigDir, entries);
  console.log(`overhead: fresh ${args[0]} summary ${args[1] || "unchanged"}`);
}
async function cmdDump(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.DUMP;
    console.log(`dump: ${v || "off"}`);
    return;
  }
  if (args[0] === "off") {
    await dropSettings(claudeConfigDir, ["DUMP"]);
    console.log("dump: off");
    return;
  }
  await putSetting(claudeConfigDir, "DUMP", args[0]);
  console.log(`dump: ${args[0]}`);
}
async function cmdReset(claudeConfigDir, args) {
  const validKeys = [
    "BASE_MODEL",
    "SECTIONS",
    "RESETS",
    "CONTEXT_WARN",
    "CONTEXT_CRIT",
    "CACHE_WARN",
    "CACHE_CRIT",
    "RESET_WARN",
    "RESET_CRIT",
    "WIDTH",
    "MARGIN",
    "DUMP",
    "FRESH_TOKENS",
    "SUMMARY_TOKENS",
    "OVERHEAD_WARN",
    "OVERHEAD_CRIT"
  ];
  if (args.length === 0) {
    await resetAllSettings(claudeConfigDir);
    console.log("all saved settings removed");
  } else {
    for (const k of args) {
      if (!validKeys.includes(k))
        die(`invalid key: ${k}`);
    }
    await dropSettings(claudeConfigDir, args);
    console.log(`removed: ${args.join(" ")}`);
  }
}
async function runConfig(argv) {
  const claudeConfigDir = getClaudeConfigDir();
  const { command, args } = parseArgs(argv);
  switch (command) {
    case "show":
      await cmdShow(claudeConfigDir);
      break;
    case "model":
      await cmdModel(claudeConfigDir, args);
      break;
    case "sections":
      await cmdSections(claudeConfigDir, args);
      break;
    case "resets":
      await cmdResets(claudeConfigDir, args);
      break;
    case "thresholds":
      await cmdThresholds(claudeConfigDir, args);
      break;
    case "width":
      await cmdWidth(claudeConfigDir, args);
      break;
    case "margin":
      await cmdMargin(claudeConfigDir, args);
      break;
    case "overhead":
      await cmdOverhead(claudeConfigDir, args);
      break;
    case "dump":
      await cmdDump(claudeConfigDir, args);
      break;
    case "reset":
      await cmdReset(claudeConfigDir, args);
      break;
    case "help":
    case "-h":
    case "--help":
    case "":
      usage();
      break;
    default:
      usage();
      process.exit(1);
  }
}

// dist/index.js
init_refresh_prices();

// dist/install.js
import { join as join8 } from "path";
import { promises as fs6 } from "fs";
import { fileURLToPath as fileURLToPath7 } from "url";
var __filename7 = fileURLToPath7(import.meta.url);
var __dirname6 = join8(__filename7, "..");
async function copyScripts(srcDir, destDir) {
  await fs6.mkdir(destDir, { recursive: true });
  const isBundled = __filename7.includes("/bin/statusline") || __filename7.includes("\\bin\\statusline");
  if (isBundled) {
    const executable = join8(__dirname6, "statusline");
    const dest = join8(destDir, "statusline");
    try {
      await fs6.copyFile(executable, dest);
      await fs6.chmod(dest, 493);
    } catch {
      console.warn("Could not find compiled executable, skipping copy");
    }
  } else {
    const jsScripts = ["statusline.js", "config.js", "refresh-prices.js"];
    for (const script of jsScripts) {
      const src = join8(__dirname6, "..", "dist", script);
      const dest = join8(destDir, script.replace(".js", ""));
      try {
        await fs6.copyFile(src, dest);
        await fs6.chmod(dest, 493);
      } catch {
      }
    }
  }
}
async function configureSettings(claudeConfigDir, destDir, options) {
  const settingsPath = join8(claudeConfigDir, "settings.json");
  const executablePath = join8(destDir, "statusline");
  const cmd = `node ${executablePath}`;
  try {
    await fs6.access(settingsPath);
  } catch {
    await fs6.writeFile(settingsPath, "{}");
  }
  const content = await fs6.readFile(settingsPath, "utf-8");
  const settings = JSON.parse(content);
  const currentCmd = settings.statusLine?.command;
  if (currentCmd && currentCmd !== cmd && !options.force) {
    console.log(`statusLine already set to: ${currentCmd} (re-run with --force to replace)`);
    return;
  }
  settings.statusLine = {
    type: "command",
    command: cmd,
    refreshInterval: options.interval
  };
  const tmp = `${settingsPath}.${Date.now()}.tmp`;
  await fs6.writeFile(tmp, JSON.stringify(settings, null, 2));
  await fs6.rename(tmp, settingsPath);
  console.log(`statusLine set to: ${cmd} (refresh every ${options.interval}s)`);
}
async function install(options) {
  const claudeConfigDir = getClaudeConfigDir();
  const destDir = join8(claudeConfigDir, "statusline");
  const srcDir = join8(__dirname6, "..", "src");
  await copyScripts(srcDir, destDir);
  if (options.configure) {
    await configureSettings(claudeConfigDir, destDir, options);
  }
}

// dist/index.js
function parseArgs2(argv) {
  if (argv.length === 0)
    return { command: "statusline", args: [] };
  return { command: argv[0], args: argv.slice(1) };
}
async function runAgentCommand(args) {
  const subcommand = args[0] || "help";
  switch (subcommand) {
    case "list": {
      const agents = adapterRegistry.getAgentTypes();
      console.log("Available agents:");
      for (const agent of agents) {
        const adapter = adapterRegistry.get(agent);
        console.log(`  ${agent}${adapter ? "" : " (no adapter)"}`);
      }
      break;
    }
    case "detect": {
      if (args.length < 2) {
        console.error("Usage: statusline agent detect <file>");
        process.exit(1);
      }
      const filePath = args[1];
      try {
        const { readFileSync } = await import("fs");
        const input = JSON.parse(readFileSync(filePath, "utf-8"));
        const adapter = adapterRegistry.detect(input);
        if (adapter) {
          console.log(`Detected agent: ${adapter.agentType}`);
        } else {
          console.log("No matching agent detected (would fall back to claude-code)");
        }
      } catch (e) {
        console.error(`Failed to detect agent: ${e instanceof Error ? e.message : String(e)}`);
        process.exit(1);
      }
      break;
    }
    case "current": {
      const fallback = adapterRegistry.get("claude-code");
      console.log(`Current agent (fallback): ${fallback?.agentType || "claude-code"}`);
      console.log("Note: Agent is auto-detected from input JSON at runtime");
      break;
    }
    case "help":
    case "-h":
    case "--help":
    case "": {
      console.log(`Usage: statusline agent <subcommand>
  
Subcommands:
  list          List available agents
  detect <file> Detect agent from input JSON file
  current       Show current agent (fallback)`);
      break;
    }
    default: {
      console.error(`Unknown agent subcommand: ${subcommand}`);
      console.error("Run 'statusline agent help' for usage");
      process.exit(1);
    }
  }
}
async function main() {
  const argv = process.argv.slice(2);
  const { command, args } = parseArgs2(argv);
  switch (command) {
    case "statusline": {
      const chunks = [];
      for await (const chunk of process.stdin) {
        chunks.push(chunk);
      }
      const input = Buffer.concat(chunks).toString("utf-8");
      const line = await generateStatusLine(input);
      console.log(line);
      break;
    }
    case "config": {
      await runConfig(args);
      break;
    }
    case "refresh-prices": {
      const claudeConfigDir = getClaudeConfigDir();
      const ttl = parseInt(process.env.STATUSLINE_PRICES_TTL || "3600", 10);
      await refreshPrices(claudeConfigDir, ttl);
      break;
    }
    case "install": {
      let configure = false;
      let force = false;
      let interval = 15;
      for (let i = 0; i < args.length; i++) {
        switch (args[i]) {
          case "--configure":
            configure = true;
            break;
          case "--force":
            force = true;
            break;
          case "--interval":
            interval = parseInt(args[++i], 10);
            if (isNaN(interval) || interval <= 0) {
              console.error("--interval needs a positive number of seconds");
              process.exit(1);
            }
            break;
          default:
            console.error(`unknown option: ${args[i]}`);
            process.exit(1);
        }
      }
      if (configure) {
        await install({ configure, force, interval });
      }
      break;
    }
    case "agent": {
      await runAgentCommand(args);
      break;
    }
    case "help":
    case "-h":
    case "--help":
      console.log(`claude-code-status-line - TypeScript rewrite

Usage: statusline <command> [args]

Commands:
  statusline          Generate status line (reads JSON from stdin)
  config <subcommand> Manage settings
  refresh-prices      Fetch and cache model prices
  install             Install/copy scripts and optionally configure settings.json
  agent <subcommand>  Manage multi-agent support

Config subcommands:
  show                Show current settings
  model [NAME|list]   Base model for price multiplier
  sections ...        Show/hide sections
  resets LIST         Which reset windows to show
  thresholds ...      Yellow/red breakpoints
  width [N|auto]      Terminal width
  margin N            Right margin
  overhead [FRESH [SUMMARY]]  Token sizes for overhead metric
  dump [PATH|off]     Debug dump path
  reset [KEY...]      Drop saved settings

Agent subcommands:
  list                List available agents
  detect <file>       Detect agent from input JSON file
  current             Show current agent (fallback)

Install options:
  --configure         Configure settings.json
  --force             Replace existing statusLine
  --interval SECONDS  Refresh interval (default 15)

Run 'statusline config help' for detailed config help.
Run 'statusline agent help' for agent command help.`);
      break;
    default:
      console.error(`Unknown command: ${command}`);
      console.error("Run 'statusline help' for usage");
      process.exit(1);
  }
}
main().catch((err) => {
  console.error("Error:", err);
  process.exit(1);
});
