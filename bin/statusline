// src/shared/config-file.ts
import { promises as fs } from "fs";
import { join, dirname } from "path";
import { fileURLToPath } from "url";
var __filename = fileURLToPath(import.meta.url);
var __dirname = dirname(__filename);
var configCache = null;
function getConfigPath(claudeConfigDir) {
  return join(claudeConfigDir, "statusline", "config");
}
async function loadConfig(claudeConfigDir) {
  const path = getConfigPath(claudeConfigDir);
  const data = {};
  try {
    const content = await fs.readFile(path, "utf-8");
    for (const line of content.split("\n")) {
      const idx = line.indexOf("=");
      if (idx > 0) {
        const key = line.slice(0, idx).trim();
        const value = line.slice(idx + 1).trim();
        if (key)
          data[key] = value;
      }
    }
  } catch {
  }
  configCache = { path, data };
  return data;
}
function getSetting(data, key) {
  return data[key];
}
async function putSetting(claudeConfigDir, key, value) {
  const path = getConfigPath(claudeConfigDir);
  await ensureDir(dirname(path));
  const data = configCache?.data ?? await loadConfig(claudeConfigDir);
  data[key] = value;
  const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
  const lines = Object.entries(data).map(([k, v]) => `${k}=${v}`);
  await fs.writeFile(tmp, lines.join("\n") + "\n", { mode: 420 });
  await fs.rename(tmp, path);
  configCache = { path, data };
}
async function putSettings(claudeConfigDir, entries) {
  const path = getConfigPath(claudeConfigDir);
  await ensureDir(dirname(path));
  const data = configCache?.data ?? await loadConfig(claudeConfigDir);
  for (const [key, value] of entries) {
    data[key] = value;
  }
  const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
  const lines = Object.entries(data).map(([k, v]) => `${k}=${v}`);
  await fs.writeFile(tmp, lines.join("\n") + "\n", { mode: 420 });
  await fs.rename(tmp, path);
  configCache = { path, data };
}
async function dropSettings(claudeConfigDir, keys) {
  const path = getConfigPath(claudeConfigDir);
  const data = configCache?.data ?? await loadConfig(claudeConfigDir);
  for (const key of keys) {
    delete data[key];
  }
  if (Object.keys(data).length === 0) {
    try {
      await fs.unlink(path);
    } catch {
    }
    configCache = { path, data: {} };
  } else {
    const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
    const lines = Object.entries(data).map(([k, v]) => `${k}=${v}`);
    await fs.writeFile(tmp, lines.join("\n") + "\n", { mode: 420 });
    await fs.rename(tmp, path);
    configCache = { path, data };
  }
}
async function resetAllSettings(claudeConfigDir) {
  const path = getConfigPath(claudeConfigDir);
  try {
    await fs.unlink(path);
  } catch {
  }
  configCache = { path, data: {} };
}
async function ensureDir(dir) {
  try {
    await fs.mkdir(dir, { recursive: true });
  } catch {
  }
}

// src/adapters/adapter.ts
var AdapterRegistry = class {
  adapters = [];
  agentTypeMap = /* @__PURE__ */ new Map();
  /**
   * Register an adapter
   * Order matters for auto-detection - more specific adapters should be registered first
   */
  register(adapter) {
    this.adapters.push(adapter);
    this.agentTypeMap.set(adapter.agentType, adapter);
  }
  /**
   * Auto-detect the correct adapter for the given input
   * Returns the first adapter whose canHandle() returns true
   */
  detect(input) {
    for (const adapter of this.adapters) {
      if (adapter.canHandle(input)) {
        return adapter;
      }
    }
    return void 0;
  }
  /**
   * Get adapter by agent type
   */
  get(agentType) {
    return this.agentTypeMap.get(agentType);
  }
  /**
   * Get all registered agent types
   */
  getAgentTypes() {
    return Array.from(this.agentTypeMap.keys());
  }
  /**
   * Get all registered adapters
   */
  getAll() {
    return [...this.adapters];
  }
  /**
   * Parse input using the appropriate adapter (auto-detect if not specified)
   */
  parse(input, agentType) {
    let adapter;
    if (agentType) {
      adapter = this.get(agentType);
      if (!adapter) {
        throw new Error(`Unknown agent type: ${agentType}`);
      }
    } else {
      adapter = this.detect(input);
      if (!adapter) {
        adapter = this.get("claude-code");
        if (!adapter) {
          throw new Error("No adapter available and no default found");
        }
      }
    }
    return adapter.parse(input);
  }
};
var adapterRegistry = new AdapterRegistry();
function createCanHandle(requiredFields) {
  return (input) => {
    if (!input || typeof input !== "object")
      return false;
    const obj = input;
    for (const [field, check] of Object.entries(requiredFields)) {
      if (!(field in obj) || !check(obj[field])) {
        return false;
      }
    }
    return true;
  };
}

// src/adapters/claude-code.ts
function isClaudeCodeInput(input) {
  return input.hook_event_name === "Status" && typeof input.session_id === "string" && typeof input.model === "object" && input.model !== null && typeof input.model.id === "string" && typeof input.model.display_name === "string" && typeof input.context_window === "object" && input.context_window !== null && typeof input.cost === "object" && input.cost !== null && typeof input.prompt_cache === "object" && input.prompt_cache !== null;
}
var ClaudeCodeAdapter = class {
  agentType = "claude-code";
  // Detection: hook_event_name === "Status" + prompt_cache + rate_limits
  canHandle = createCanHandle({
    hook_event_name: (v) => v === "Status",
    prompt_cache: (v) => v !== null && typeof v === "object",
    rate_limits: (v) => v !== null && typeof v === "object"
  });
  parse(input) {
    if (!isClaudeCodeInput(input)) {
      throw new Error("Invalid Claude Code input format");
    }
    const timestamp = Date.now();
    const model = {
      id: input.model.id,
      displayName: input.model.display_name,
      provider: "anthropic",
      capabilities: {
        effortLevel: input.effort?.level ?? void 0
      }
    };
    const contextWindow = input.context_window;
    const totalInputTokens = contextWindow.total_input_tokens ?? 0;
    const totalOutputTokens = contextWindow.total_output_tokens ?? 0;
    const context = {
      usedTokens: totalInputTokens + totalOutputTokens,
      maxTokens: contextWindow.context_window_size ?? 0,
      usedPercentage: contextWindow.used_percentage ?? null
    };
    const currentUsage = contextWindow.current_usage;
    const usage2 = {
      inputTokens: totalInputTokens,
      outputTokens: totalOutputTokens,
      cacheReadTokens: currentUsage?.cache_read_input_tokens ?? void 0,
      cacheWriteTokens: currentUsage?.cache_creation_input_tokens ?? void 0
    };
    const cost = {
      sessionCostUsd: input.cost.total_cost_usd ?? null,
      totalCostUsd: input.cost.total_cost_usd,
      // same as session for now
      currency: "USD"
    };
    const promptCache = input.prompt_cache ?? {};
    const cache = {
      ttlSeconds: promptCache.ttl ?? null,
      warm: promptCache.warm ?? false,
      hitRatio: promptCache.hit_ratio ?? void 0,
      expiresAt: promptCache.expires_at ?? void 0,
      recacheTokensIfCold: promptCache.recache_tokens_if_cold ?? void 0
    };
    const rateLimits = this.parseRateLimits(input.rate_limits ?? {});
    const extensions = {
      vimMode: input.vim?.mode,
      worktree: input.worktree ? {
        name: input.worktree.name,
        path: input.worktree.path,
        branch: input.worktree.branch
      } : void 0,
      outputStyle: input.output_style?.name,
      fastMode: input.fast_mode
    };
    return {
      agent: this.agentType,
      sessionId: input.session_id,
      timestamp,
      model,
      context,
      usage: usage2,
      cost,
      cache,
      rateLimits,
      extensions
    };
  }
  parseRateLimits(rateLimits) {
    const rows = [];
    const nums = {
      one: 1,
      two: 2,
      three: 3,
      four: 4,
      five: 5,
      six: 6,
      seven: 7,
      eight: 8,
      nine: 9,
      ten: 10,
      thirty: 30
    };
    const unitMap = {
      hour: "h",
      day: "d",
      week: "w",
      month: "mo"
    };
    for (const [key, value] of Object.entries(rateLimits)) {
      if (!value || typeof value !== "object" || value.resets_at == null)
        continue;
      let id = "";
      let name = "";
      let period = "custom";
      if (key === "spend_limit") {
        id = "spend";
        name = "Spend limit";
        const periodMap = { daily: "24h", weekly: "7d", monthly: "30d" };
        period = value.period && periodMap[value.period] || "custom";
      } else {
        const match = key.match(/^([a-z]+)_(hour|day|week|month)(?:_(.+))?$/);
        if (match && nums[match[1]]) {
          const n = nums[match[1]];
          const u = unitMap[match[2]];
          id = `${n}${u}`;
          if (match[3]) {
            id += `-${match[3].replace(/_/g, "-")}`;
            name = match[3].replace(/_/g, " ");
          } else {
            name = id;
          }
          period = { h: "5h", d: "24h", w: "7d", mo: "30d" }[u] || "custom";
        } else {
          id = key;
          name = key;
        }
      }
      const usedPercentage = value.used_percentage != null ? Math.round(value.used_percentage) : null;
      rows.push({
        id,
        name,
        used: usedPercentage,
        limit: 100,
        // percentage-based, so limit is 100%
        usedPercentage,
        resetsAt: value.resets_at,
        period
      });
    }
    return rows;
  }
  formatOutput(line, _extensions) {
    return line;
  }
};
var claudeCodeAdapter = new ClaudeCodeAdapter();

// src/adapters/cursor.ts
function isCursorInput(input) {
  return typeof input.render_width_chars === "number" && typeof input.autorun === "boolean" && typeof input.model === "object" && input.model !== null && typeof input.model.param_summary === "string" && typeof input.session_id === "string" && typeof input.context_window === "object" && input.context_window !== null;
}
var CursorAdapter = class {
  agentType = "cursor";
  // Detection: render_width_chars (number) + autorun (boolean) + model.param_summary (string)
  canHandle = createCanHandle({
    render_width_chars: (v) => typeof v === "number",
    autorun: (v) => typeof v === "boolean",
    model: (v) => v !== null && typeof v === "object" && v.param_summary !== void 0
  });
  parse(input) {
    if (!isCursorInput(input)) {
      throw new Error("Invalid Cursor input format");
    }
    const timestamp = Date.now();
    const model = {
      id: input.model.id,
      displayName: input.model.display_name,
      provider: "anthropic",
      // Cursor uses Anthropic models
      capabilities: {
        paramSummary: input.model.param_summary,
        maxMode: input.model.max_mode
      }
    };
    const contextWindow = input.context_window;
    const totalInputTokens = contextWindow.total_input_tokens ?? 0;
    const totalOutputTokens = contextWindow.total_output_tokens ?? 0;
    const context = {
      usedTokens: totalInputTokens + totalOutputTokens,
      maxTokens: contextWindow.context_window_size ?? 0,
      usedPercentage: contextWindow.used_percentage ?? null
    };
    const currentUsage = contextWindow.current_usage;
    const usage2 = {
      inputTokens: totalInputTokens,
      outputTokens: totalOutputTokens,
      // Cursor doesn't expose cache tokens
      cacheReadTokens: void 0,
      cacheWriteTokens: void 0
    };
    const cost = {
      sessionCostUsd: null,
      currency: "USD"
    };
    const cache = {
      ttlSeconds: null,
      warm: false,
      hitRatio: void 0,
      expiresAt: void 0,
      recacheTokensIfCold: void 0
    };
    const rateLimits = [];
    const extensions = {
      renderWidthChars: input.render_width_chars,
      autorun: input.autorun,
      paramSummary: input.model.param_summary,
      maxMode: input.model.max_mode,
      vimMode: input.vim?.mode,
      worktree: input.worktree ? {
        name: input.worktree.name,
        path: input.worktree.path
      } : void 0,
      outputStyle: input.output_style?.name,
      sessionName: input.session_name
    };
    return {
      agent: this.agentType,
      sessionId: input.session_id,
      timestamp,
      model,
      context,
      usage: usage2,
      cost,
      cache,
      rateLimits,
      extensions
    };
  }
  formatOutput(line, _extensions) {
    return line;
  }
};
var cursorAdapter = new CursorAdapter();

// src/adapters/index.ts
adapterRegistry.register(cursorAdapter);
adapterRegistry.register(claudeCodeAdapter);

// dist/formatter.js
