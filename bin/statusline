// src/shared/colors.ts
var RESET = "\x1B[0m";
var DIM = "\x1B[2m";
var CYAN = "\x1B[36m";
var GREEN = "\x1B[32m";
var YELLOW = "\x1B[33m";
var RED = "\x1B[31m";
function dim(text) {
  return `${DIM}${text}${RESET}`;
}
function cyan(text) {
  return `${CYAN}${text}${RESET}`;
}
function green(text) {
  return `${GREEN}${text}${RESET}`;
}
function yellow(text) {
  return `${YELLOW}${text}${RESET}`;
}
function red(text) {
  return `${RED}${text}${RESET}`;
}

// src/shared/formatting.ts
init_constants();
function fmtDur(seconds) {
  let s = Math.max(0, Math.floor(seconds));
  let out = "";
  let parts = 0;
  let started = false;
  for (const { unit, seconds: unitSecs } of DURATION_UNITS) {
    const n = Math.floor(s / unitSecs);
    s = s % unitSecs;
    if (started || n > 0) {
      started = true;
      parts++;
      out += (out ? " " : "") + n + unit;
      if (parts >= 2)
        break;
    }
  }
  return out || "0s";
}
function fmtTok(n) {
  if (n >= 1e6) {
    return `${Math.floor(n / 1e6)}.${Math.floor(n % 1e6 / 1e5)}M`;
  }
  if (n >= 1e4) {
    return `${Math.floor(n / 1e3)}k`;
  }
  if (n >= 1e3) {
    return `${Math.floor(n / 1e3)}.${Math.floor(n % 1e3 / 100)}k`;
  }
  return String(n);
}
function money(dollars) {
  const c = dollars * 100;
  if (c < 1)
    return "<1\xA2";
  if (c < 100)
    return `${Math.round(c)}\xA2`;
  return `$${dollars.toFixed(2)}`;
}

// src/shared/terminal.ts
init_constants();
import { spawn } from "child_process";
function visibleWidth(str) {
  let t = str.replace(/\x1b\[[0-9;]*m/g, "");
  for (const ch of ALL_BLOCK_CHARS) {
    t = t.split(ch).join("x");
  }
  return t.length;
}

// dist/formatter.legacy.js
init_prices();
function convertRateLimitWindow(window) {
  return {
    key: window.id,
    alias: window.id,
    name: window.name,
    pct: window.usedPercentage != null ? String(window.usedPercentage) : "-",
    resets_at: String(window.resetsAt),
    total: window.limit != null ? String(window.limit) : "-"
  };
}
function parseCustomReset() {
  const custom = process.env.STATUSLINE_CUSTOM_RESET;
  if (!custom)
    return null;
  const [label, dateStr] = custom.split("|");
  if (!label || !dateStr)
    return null;
  let timestamp;
  try {
    timestamp = new Date(dateStr).getTime();
    if (isNaN(timestamp))
      throw new Error();
  } catch {
    try {
      timestamp = new Date(dateStr.replace(" ", "T")).getTime();
      if (isNaN(timestamp))
        throw new Error();
    } catch {
      return null;
    }
  }
  return { label, timestamp: Math.floor(timestamp / 1e3) };
}
function isSectionEnabled(sections, name) {
  return sections.split(",").includes(name);
}
function buildLimits(rateLimits, resetsSetting, showNamed, showTotal, resetWarn, resetCrit) {
  const limits = [];
  let want;
  if (resetsSetting === "all") {
    want = rateLimits.map((r) => r.key);
  } else if (resetsSetting === "none") {
    want = [];
  } else {
    want = resetsSetting.split(",").map((s) => s.trim());
  }
  for (const tok of want) {
    if (tok === "none")
      continue;
    for (const row of rateLimits) {
      if (tok !== row.key && tok !== row.alias)
        continue;
      if (row.name && !showNamed)
        continue;
      let namePart = "";
      if (row.name)
        namePart = `${dim(row.name)} `;
      let pctPart = "";
      if (row.pct !== "-") {
        const rpct = parseInt(row.pct, 10);
        let lcolor = GREEN;
        if (rpct >= resetCrit)
          lcolor = RED;
        else if (rpct >= resetWarn)
          lcolor = YELLOW;
        pctPart = `${lcolor}${rpct}%${RESET} `;
      }
      let totPart = "";
      if (showTotal && row.total !== "-") {
        totPart = ` ${dim(`/ ${row.total}`)}`;
      }
      const now = Math.floor(Date.now() / 1e3);
      const left = parseInt(row.resets_at, 10) - now;
      limits.push(`${namePart}${pctPart}${fmtDur(left)}${totPart}`);
    }
  }
  return limits;
}
async function computeParts(unified, settings, prices) {
  const { model, context, usage: usage2, cost, cache, extensions } = unified;
  let modelDisplay = model.displayName;
  const mult = matchModelPrice(prices, model.displayName, settings.baseModel, extensions.fastMode === true);
  if (mult !== null && mult !== 1) {
    const m1 = mult.toFixed(1);
    if (m1 !== "1.0") {
      modelDisplay = `${model.displayName} x${m1.replace(/\.0$/, "")}`;
    }
  }
  let effortDisplay = "";
  const effortLevel = model.capabilities.effortLevel;
  switch (effortLevel) {
    case "low":
      effortDisplay = dim("lo");
      break;
    case "medium":
      effortDisplay = green("med");
      break;
    case "high":
      effortDisplay = yellow("hi");
      break;
    case "xhigh":
      effortDisplay = red("xhi");
      break;
    case "max":
      effortDisplay = red("max");
      break;
    default:
      if (effortLevel)
        effortDisplay = dim(effortLevel);
  }
  let contextBar = "";
  let contextBarShort = "";
  let pctUsed = 0;
  if (context.usedPercentage !== null) {
    pctUsed = Math.round(context.usedPercentage);
    const blockIdx = Math.min(Math.floor(pctUsed / 12.5), 7);
    const fill = BLOCK_CHARS[blockIdx];
    let color = GREEN;
    if (pctUsed >= settings.contextCrit)
      color = RED;
    else if (pctUsed >= settings.contextWarn)
      color = YELLOW;
    const ctxChar = `${color}${LEFT_BORDER}${fill}${RIGHT_BORDER}${RESET}`;
    const ctxPct = `${color}${pctUsed}%${RESET}`;
    const sizeStr = context.maxTokens ? `${DIM}/${context.maxTokens >= 1e6 ? Math.floor(context.maxTokens / 1e6) + "M" : Math.floor(context.maxTokens / 1e3) + "k"}${RESET}` : "";
    contextBar = `${ctxChar} ${ctxPct}${sizeStr}`;
    contextBarShort = `${ctxChar} ${ctxPct}`;
  } else {
    contextBar = `${DIM}(no context data)${RESET}`;
    contextBarShort = contextBar;
  }
  let tokensDisplay = "";
  if (usage2.inputTokens !== null && usage2.outputTokens !== null) {
    tokensDisplay = `${fmtTok(usage2.inputTokens + usage2.outputTokens)} ${dim("tok")}`;
  }
  let costDisplay = "";
  if (cost.sessionCostUsd !== null) {
    costDisplay = `${money(cost.sessionCostUsd)} ${dim("sess")}`;
  }
  let cacheDisplay = "";
  let cacheShortDisplay = "";
  let cacheCold = false;
  if (cache.ttlSeconds !== null) {
    const statsEnabled = isSectionEnabled(settings.sections, "stats");
    let stats = "";
    if (cache.hitRatio != null && (statsEnabled || cache.hitRatio < 0.8)) {
      const sp = Math.round(cache.hitRatio * 100);
      const scolor = sp < 80 ? RED : GREEN;
      stats = ` ${scolor}${sp}%${RESET}`;
    }
    if (cache.warm && cache.expiresAt != null) {
      const now = Math.floor(Date.now() / 1e3);
      const rem = cache.expiresAt - now;
      if (rem > 0) {
        let ccolor = GREEN;
        if (rem < settings.cacheWarn * 60)
          ccolor = YELLOW;
        if (rem < settings.cacheCrit * 60)
          ccolor = RED;
        let remMinutes = rem >= 60 ? Math.floor(rem / 60) * 60 : rem;
        let ctime = fmtDur(remMinutes);
        ctime = ctime.replace(/ 0s$/, "").replace(/ /g, "");
        cacheDisplay = `${dim("\u23F1")} ${ccolor}${ctime}${RESET}`;
      }
    }
    if (!cacheDisplay) {
      cacheDisplay = red("\u23F1 cold");
      cacheCold = true;
    }
    cacheShortDisplay = cacheDisplay;
    cacheDisplay = `${cacheDisplay}${stats}`;
  }
  let overheadDisplay = "";
  let overheadShortDisplay = "";
  const ctoks = cache.recacheTokensIfCold;
  if (isSectionEnabled(settings.sections, "overhead") && cache.ttlSeconds !== null && ctoks != null) {
    if (ctoks > settings.freshTokens) {
      const modelPrices = prices.models[model.displayName] || prices.models[`Claude ${model.displayName}`] || prices.models[model.displayName.toLowerCase()] || prices.models[`claude ${model.displayName.toLowerCase()}`];
      if (modelPrices) {
        const pin = extensions.fastMode === true && modelPrices.fast_in ? modelPrices.fast_in : modelPrices.in;
        const pout = modelPrices.out;
        const wmul = cache.ttlSeconds === 3600 ? 2 : 1.25;
        const d = ctoks - settings.freshTokens;
        const oCall = d * 0.1 * pin / 1e6;
        const oCold = d * wmul * pin / 1e6;
        const oBe = settings.freshTokens * wmul / (d * 0.1);
        const oCompact = (ctoks * 0.1 * pin + settings.summaryTokens * pout + (settings.freshTokens + settings.summaryTokens) * wmul * pin) / 1e6;
        const ocents = Math.round(oCall * 100);
        let ocolor = GREEN;
        if (ocents >= settings.overheadWarn)
          ocolor = YELLOW;
        if (ocents >= settings.overheadCrit)
          ocolor = RED;
        const be = Math.ceil(oBe);
        const beDisplay = be < 1 ? 1 : be;
        if (cacheCold) {
          overheadShortDisplay = `${RED}cold +${money(oCold)}${RESET}`;
          overheadDisplay = overheadShortDisplay;
        } else {
          overheadShortDisplay = `${ocolor}+${money(oCall)}/call${RESET}`;
          overheadDisplay = `${overheadShortDisplay} ${dim(`new@${beDisplay}`)}`;
        }
        if (context.usedPercentage !== null && context.usedPercentage >= settings.contextCrit) {
          const compactStr = ` ${dim("compact")} ${money(oCompact)}`;
          overheadDisplay += compactStr;
          overheadShortDisplay += compactStr;
        }
      }
    }
  }
  const customReset = parseCustomReset();
  const custom = customReset ? `${dim(customReset.label)} ${fmtDur(customReset.timestamp - Math.floor(Date.now() / 1e3))}` : null;
  return {
    model: `${cyan(modelDisplay)}${effortDisplay ? ` ${effortDisplay}` : ""}`,
    context: contextBar,
    contextShort: contextBarShort,
    tokens: tokensDisplay,
    cost: costDisplay,
    overhead: overheadDisplay,
    overheadShort: overheadShortDisplay,
    cache: cacheDisplay,
    cacheShort: cacheShortDisplay,
    limits: [],
    custom
  };
}
function render(parts, settings, level, rateLimits, customReset) {
  const sep = `${DIM} | ${RESET}`;
  const showNamed = level < 1;
  let showTotal = level < 3;
  const onlyFirstWindow = level >= 4;
  let modelPart = parts.model;
  let contextPart = parts.context;
  let cachePart = parts.cache;
  let overheadPart = parts.overhead;
  let costPart = parts.cost;
  let tokensPart = parts.tokens;
  let customPart = parts.custom;
  if (level >= 1) {
    contextPart = parts.contextShort;
    customPart = null;
  }
  if (level >= 2) {
    cachePart = parts.cacheShort;
    overheadPart = parts.overheadShort;
  }
  if (level >= 3) {
    showTotal = false;
    costPart = "";
  }
  if (level >= 4) {
    modelPart = cyan(parts.model.split(" x")[0]);
  }
  if (level >= 5) {
    cachePart = "";
    tokensPart = "";
    overheadPart = "";
  }
  if (level >= 6) {
  }
  const limits = buildLimits(rateLimits, settings.resets, showNamed, showTotal, settings.resetWarn, settings.resetCrit);
  let finalLimits = limits;
  if (onlyFirstWindow) {
    finalLimits = limits.slice(0, 1);
  }
  if (level === 0 && customPart) {
    finalLimits = [...finalLimits, customPart];
  }
  const enabledSections = settings.sections.split(",");
  const outputParts = [];
  if (enabledSections.includes("model"))
    outputParts.push(modelPart);
  if (enabledSections.includes("context")) {
    if (enabledSections.includes("overhead")) {
      outputParts.push(`${contextPart}${overheadPart ? ` ${overheadPart}` : ""}`);
    } else {
      outputParts.push(contextPart);
    }
  } else if (enabledSections.includes("overhead")) {
    outputParts.push(overheadPart);
  }
  if (enabledSections.includes("tokens"))
    outputParts.push(tokensPart);
  if (enabledSections.includes("cost"))
    outputParts.push(costPart);
  if (enabledSections.includes("cache"))
    outputParts.push(cachePart);
  if (enabledSections.includes("resets"))
    outputParts.push(...finalLimits);
  return outputParts.filter((p) => p).join(sep);
}
async function formatStatusLine(unified, options = {}) {
  const { width = DEFAULT_WIDTH, margin = DEFAULT_MARGIN, sections = DEFAULT_SECTIONS, resets = DEFAULT_RESETS, contextWarn = DEFAULT_CONTEXT_WARN, contextCrit = DEFAULT_CONTEXT_CRIT, cacheWarn = DEFAULT_CACHE_WARN, cacheCrit = DEFAULT_CACHE_CRIT, resetWarn = DEFAULT_RESET_WARN, resetCrit = DEFAULT_RESET_CRIT, freshTokens = DEFAULT_FRESH_TOKENS, summaryTokens = DEFAULT_SUMMARY_TOKENS, overheadWarn = DEFAULT_OVERHEAD_WARN, overheadCrit = DEFAULT_OVERHEAD_CRIT, baseModel = DEFAULT_BASE_MODEL, pricesTtl = 3600, dumpPath, claudeConfigDir } = options;
  const prices = await loadPrices(claudeConfigDir || "", pricesTtl);
  const rateLimits = unified.rateLimits.map(convertRateLimitWindow);
  const settings = {
    baseModel,
    sections,
    resets,
    pricesTtl,
    contextWarn,
    contextCrit,
    cacheWarn,
    cacheCrit,
    resetWarn,
    resetCrit,
    width,
    margin,
    dumpPath: dumpPath || "",
    freshTokens,
    summaryTokens,
    overheadWarn,
    overheadCrit
  };
  const parts = await computeParts(unified, settings, prices);
  const customReset = parseCustomReset();
  let level = 0;
  let line = render(parts, settings, level, rateLimits, customReset);
  let cols = width;
  if (cols === 0) {
    const agentWidth = unified.extensions.renderWidthChars;
    if (typeof agentWidth === "number" && agentWidth > 0) {
      cols = agentWidth;
    }
  }
  if (cols > 0) {
    while (visibleWidth(line) > cols - margin && level < 6) {
      level++;
      line = render(parts, settings, level, rateLimits, customReset);
    }
  }
  if (dumpPath) {
    try {
      const { promises: fs7 } = await import("fs");
      await fs7.appendFile(dumpPath, `
cols=${cols} margin=${margin} level=${level} visible=${visibleWidth(line)}`);
    } catch {
    }
  }
  return line;
}

// dist/shared/prices.js
import { promises as fs3 } from "fs";
import { join as join3, dirname as dirname3 } from "path";
import { fileURLToPath as fileURLToPath3 } from "url";

// dist/shared/constants.js
var DEFAULT_PRICES_TTL2 = 3600;
var BLOCK_CHARS2 = ["\u2581", "\u2582", "\u2583", "\u2584", "\u2585", "\u2586", "\u2587", "\u2588"];
var LEFT_BORDER2 = "\u2595";
var RIGHT_BORDER2 = "\u258F";
var ALL_BLOCK_CHARS2 = [...BLOCK_CHARS2, LEFT_BORDER2, RIGHT_BORDER2];

// dist/shared/prices.js
var __filename3 = fileURLToPath3(import.meta.url);
var __dirname3 = dirname3(__filename3);
var pricesCache2 = null;
function getPricesPath2(claudeConfigDir) {
  return join3(claudeConfigDir, "model-prices.json");
}
async function loadPrices2(claudeConfigDir, ttl = DEFAULT_PRICES_TTL2) {
  const path = getPricesPath2(claudeConfigDir);
  const now = Date.now();
  if (pricesCache2 && now - pricesCache2.mtime < ttl * 1e3) {
    return pricesCache2.table;
  }
  try {
    const stat = await fs3.stat(path);
    if (now - stat.mtimeMs < ttl * 1e3) {
      const content = await fs3.readFile(path, "utf-8");
      const table = JSON.parse(content);
      pricesCache2 = { table, mtime: stat.mtimeMs };
      return table;
    }
  } catch {
  }
  return { models: {} };
}
function matchModelPrice2(table, modelName, baseModel, fastMode) {
  const models = table.models;
  const base = models[baseModel]?.in;
  if (!base || base === 0)
    return null;
  const candidates = [
    modelName,
    `Claude ${modelName}`,
    modelName.toLowerCase(),
    `claude ${modelName.toLowerCase()}`
  ];
  let matched;
  for (const c of candidates) {
    if (models[c]) {
      matched = models[c];
      break;
    }
  }
  if (!matched)
    return null;
  const inputPrice = fastMode && matched.fast_in ? matched.fast_in : matched.in;
  const multiplier = inputPrice / base * 10;
  return Math.round(multiplier) / 10;
}

