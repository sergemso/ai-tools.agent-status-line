// packages/core/dist/sections/overhead.js
var OVERHEAD_WARN = 5;
var OVERHEAD_CRIT = 20;
var OVERHEAD_SECTION_ID = "overhead";
function createOverheadItems(input) {
  const overhead = input.overhead;
  if (!overhead)
    return [];
  const items = [];
  if (!overhead.show) {
    return [];
  }
  if (overhead.costPerCall !== void 0) {
    items.push({
      id: "costPerCall",
      content: (ctx) => renderOverheadCost(ctx.input.overhead, ctx.config),
      priority: PriorityLevel.MEDIUM,
      minWidth: 8,
      idealWidth: 16,
      hints: { truncatable: false }
    });
  }
  if (overhead.breakEven !== void 0) {
    items.push({
      id: "breakEven",
      content: (ctx) => `\x1B[2mnew@${ctx.input.overhead.breakEven}\x1B[0m`,
      priority: PriorityLevel.LOW,
      minWidth: 6,
      idealWidth: 10,
      hints: { truncatable: false }
    });
  }
  if (overhead.compactCost !== void 0) {
    items.push({
      id: "compactCost",
      content: (ctx) => `\x1B[2mcompact ${formatOverheadCost(ctx.input.overhead.compactCost)}\x1B[0m`,
      priority: PriorityLevel.LOW,
      minWidth: 10,
      idealWidth: 18,
      hints: { truncatable: false }
    });
  }
  if (overhead.isCold && overhead.coldCost !== void 0) {
    items.push({
      id: "cold",
      content: (ctx) => `\x1B[31mcold +${formatOverheadCost(ctx.input.overhead.coldCost)}\x1B[0m`,
      priority: PriorityLevel.HIGH,
      minWidth: 8,
      idealWidth: 14,
      hints: { truncatable: false }
    });
  }
  return items;
}
function renderOverheadCost(overhead, config) {
  const cost = overhead.costPerCall;
  const costCents = Math.round(cost * 100);
  const warn = config?.overheadWarn ?? OVERHEAD_WARN;
  const crit = config?.overheadCrit ?? OVERHEAD_CRIT;
  let color = "\x1B[32m";
  if (costCents >= crit)
    color = "\x1B[31m";
  else if (costCents >= warn)
    color = "\x1B[33m";
  return `${color}+${formatOverheadCost(cost)}/call\x1B[0m`;
}
function formatOverheadCost(cost) {
  if (cost >= 1)
    return `$${cost.toFixed(2)}`;
  if (cost >= 0.01)
    return `$${cost.toFixed(2)}`;
  return `$${cost.toFixed(4)}`;
}
var overheadSection = {
  id: OVERHEAD_SECTION_ID,
  name: "Overhead",
  priority: PriorityLevel.MEDIUM,
  items: [],
  visibleWhen: (ctx) => !!ctx.input?.overhead?.show,
  minItems: 0
};
function createOverheadSection(ctx) {
  return {
    ...overheadSection,
    items: createOverheadItems(ctx.input)
  };
}

// packages/core/dist/sections/index.js
var DEFAULT_SECTIONS2 = [
  modelSection,
  contextSection,
  costSection,
  cacheSection,
  overheadSection,
  rateLimitsSection,
  usageSection,
  vimSection,
  worktreeSection,
  cursorExtensionsSection
];
var SECTION_FACTORIES = {
  model: createModelSection,
  context: createContextSection,
  cost: createCostSection,
  cache: createCacheSection,
  overhead: createOverheadSection,
  "rate-limits": createRateLimitsSection,
  usage: createUsageSection,
  vim: createVimSection,
  worktree: createWorktreeSection,
  "cursor-extensions": createCursorExtensionsSection
};
function getSections(config, ctx) {
  const result = [];
  for (const baseSection of DEFAULT_SECTIONS2) {
    const sectionConfig = config.sections?.[baseSection.id];
    if (sectionConfig?.enabled === false)
      continue;
    const factory = SECTION_FACTORIES[baseSection.id];
    if (!factory)
      continue;
    let section = factory(ctx);
    if (sectionConfig) {
      if (sectionConfig.priority !== void 0) {
        section = { ...section, priority: parsePriority(sectionConfig.priority) };
      }
      if (sectionConfig.minItems !== void 0) {
        section = { ...section, minItems: sectionConfig.minItems };
      }
    }
    const itemsConfig = config.items ?? {};
    section = {
      ...section,
      items: section.items.map((item) => {
        const itemConfig = itemsConfig[`${section.id}.${item.id}`] ?? itemsConfig[item.id];
        if (!itemConfig)
          return item;
        const overrides = {};
        if (itemConfig.enabled === false)
          return null;
        if (itemConfig.priority !== void 0)
          overrides.priority = parsePriority(itemConfig.priority);
        if (itemConfig.minWidth !== void 0)
          overrides.minWidth = itemConfig.minWidth;
        return { ...item, ...overrides };
      }).filter((item) => item !== null)
    };
    if (config.priorityThreshold !== void 0) {
      const threshold = parsePriority(config.priorityThreshold);
      section = {
        ...section,
        items: section.items.filter((item) => item.priority >= threshold)
      };
    }
    if (section.items.length === 0)
      continue;
    result.push(section);
  }
  return result;
}

// packages/core/dist/colors.js
var RESET2 = "\x1B[0m";
var BOLD = "\x1B[1m";
var DIM2 = "\x1B[2m";
var ITALIC = "\x1B[3m";
var UNDERLINE = "\x1B[4m";
var BLACK = "\x1B[30m";
var RED2 = "\x1B[31m";
var GREEN2 = "\x1B[32m";
var YELLOW2 = "\x1B[33m";
var BLUE = "\x1B[34m";
var MAGENTA = "\x1B[35m";
var CYAN2 = "\x1B[36m";
var WHITE = "\x1B[37m";
var GRAY = "\x1B[90m";
var BRIGHT_BLACK = "\x1B[90m";
var BRIGHT_RED = "\x1B[91m";
var BRIGHT_GREEN = "\x1B[92m";
var BRIGHT_YELLOW = "\x1B[93m";
var BRIGHT_BLUE = "\x1B[94m";
var BRIGHT_MAGENTA = "\x1B[95m";
var BRIGHT_CYAN = "\x1B[96m";
var BRIGHT_WHITE = "\x1B[97m";
function colorize(text, color) {
  return `${color}${text}${RESET2}`;
}
var style = {
  reset: (text) => `${RESET2}${text}${RESET2}`,
  bold: (text) => `${BOLD}${text}${RESET2}`,
  dim: (text) => `${DIM2}${text}${RESET2}`,
  italic: (text) => `${ITALIC}${text}${RESET2}`,
  underline: (text) => `${UNDERLINE}${text}${RESET2}`,
  // Colors
  black: (text) => colorize(text, BLACK),
  red: (text) => colorize(text, RED2),
  green: (text) => colorize(text, GREEN2),
  yellow: (text) => colorize(text, YELLOW2),
  blue: (text) => colorize(text, BLUE),
  magenta: (text) => colorize(text, MAGENTA),
  cyan: (text) => colorize(text, CYAN2),
  white: (text) => colorize(text, WHITE),
  gray: (text) => colorize(text, GRAY),
  // Bright colors
  brightRed: (text) => colorize(text, BRIGHT_RED),
  brightGreen: (text) => colorize(text, BRIGHT_GREEN),
  brightYellow: (text) => colorize(text, BRIGHT_YELLOW),
  brightBlue: (text) => colorize(text, BRIGHT_BLUE),
  brightMagenta: (text) => colorize(text, BRIGHT_MAGENTA),
  brightCyan: (text) => colorize(text, BRIGHT_CYAN),
  brightWhite: (text) => colorize(text, BRIGHT_WHITE)
};
var sectionColors = {
  model: style.cyan,
  context: style.green,
  cost: style.yellow,
  cache: style.blue,
  "rate-limits": style.magenta,
  usage: style.white,
  vim: style.gray,
  worktree: style.gray,
  "cursor-extensions": style.gray
};
var priorityColors = {
  critical: style.bold,
  high: style.white,
  medium: style.gray,
  low: style.dim,
  none: style.dim
};
var colors = {
  RESET: RESET2,
  BOLD,
  DIM: DIM2,
  BLACK,
  RED: RED2,
  GREEN: GREEN2,
  YELLOW: YELLOW2,
