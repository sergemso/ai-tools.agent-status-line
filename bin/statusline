// src/utils/fs.ts
import { promises as fs3 } from "fs";
import { dirname as dirname3 } from "path";
import { fileURLToPath as fileURLToPath3 } from "url";
async function atomicWrite(path, content, mode = 420) {
  await ensureDir3(dirname3(path));
  const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
  await fs3.writeFile(tmp, content, { mode });
  await fs3.rename(tmp, path);
}
async function tryLock(lockPath, staleAfterMs = 12e4) {
  try {
    try {
      const stat = await fs3.stat(lockPath);
      if (Date.now() - stat.mtimeMs > staleAfterMs) {
        await fs3.rmdir(lockPath);
      }
    } catch {
    }
    await fs3.mkdir(lockPath);
    return true;
  } catch {
    return false;
  }
}
async function releaseLock(lockPath) {
  try {
    await fs3.rmdir(lockPath);
  } catch {
  }
}
async function getMtime(path) {
  try {
    const stat = await fs3.stat(path);
    return stat.mtimeMs;
  } catch {
    return 0;
  }
}
async function ensureDir3(dir) {
  try {
    await fs3.mkdir(dir, { recursive: true });
  } catch {
  }
}
