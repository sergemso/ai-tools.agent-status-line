  id: CONTEXT_SECTION_ID,
  name: "Context",
  priority: PriorityLevel.HIGH,
  items: [],
  visibleWhen: (ctx) => !!ctx.input?.context,
  minItems: 1
};
function createContextSection(ctx) {
  return {
    ...contextSection,
    items: createContextItems(ctx.input)
  };
}

