// src/utils/fs.ts
import { promises as fs4 } from "fs";
import { dirname as dirname4 } from "path";
import { fileURLToPath as fileURLToPath4 } from "url";
async function atomicWrite(path, content, mode = 420) {
  await ensureDir3(dirname4(path));
  const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
  await fs4.writeFile(tmp, content, { mode });
  await fs4.rename(tmp, path);
}
async function tryLock(lockPath, staleAfterMs = 12e4) {
  try {
    try {
      const stat = await fs4.stat(lockPath);
      if (Date.now() - stat.mtimeMs > staleAfterMs) {
        await fs4.rmdir(lockPath);
      }
    } catch {
    }
    await fs4.mkdir(lockPath);
    return true;
  } catch {
    return false;
  }
}
async function releaseLock(lockPath) {
  try {
    await fs4.rmdir(lockPath);
  } catch {
  }
}
async function getMtime(path) {
  try {
    const stat = await fs4.stat(path);
    return stat.mtimeMs;
  } catch {
    return 0;
  }
}
async function ensureDir3(dir) {
  try {
    await fs4.mkdir(dir, { recursive: true });
  } catch {
  }
}
