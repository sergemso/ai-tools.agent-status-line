function parseArgs(argv) {
  if (argv.length === 0)
    return { command: "help", args: [] };
  return { command: argv[0], args: argv.slice(1) };
}
function usage() {
  console.log(`Usage: config <command>
  show                          current settings (value, and where it comes from)
  model [NAME|list]             base model for the price multiplier (x1.0); no NAME = show
  sections [list]               enabled/hidden sections and the valid names
  sections show|hide NAME...    enable/disable sections
  sections only NAME...         enable just these
  sections all                  enable all
      NAME: model context tokens cost overhead cache stats resets   (overhead = extra cost of continuing vs a fresh session; stats = always show the cache hit rate (default: only when below 80%))
  resets LIST|all|none          which reset windows to show, e.g. 5h,7d,spend
  thresholds context|resets WARN CRIT   yellow/red at WARN/CRIT percent used (0-100)
  thresholds cache WARN CRIT            yellow/red when WARN/CRIT minutes are left
  thresholds overhead WARN CRIT         yellow/red at WARN/CRIT extra cents per call vs a fresh session
  overhead [FRESH [SUMMARY]]    token sizes for the overhead metric: a fresh session (25000), a compaction summary (8000)
  width [N|auto]                terminal columns to fit the line into (auto = detect from the tty)
  margin N                      columns kept free at the right edge (default 2)
  dump [PATH|off]               write the raw status-line JSON + detected width/level to PATH on each run
  reset [KEY...]                drop saved settings (all if none given)
      KEY: BASE_MODEL SECTIONS RESETS CONTEXT_WARN CONTEXT_CRIT CACHE_WARN CACHE_CRIT RESET_WARN RESET_CRIT WIDTH MARGIN DUMP FRESH_TOKENS SUMMARY_TOKENS OVERHEAD_WARN OVERHEAD_CRIT`);
}
function die(msg) {
  console.error(`error: ${msg}`);
  process.exit(1);
}
function isInt(s) {
  return /^\d+$/.test(s);
}
function currentSections(config) {
  const v = config.SECTIONS;
  return v ? v : ALL_SECTIONS.join(",");
}
function validSection(s) {
  return ALL_SECTIONS.includes(s);
}
async function cmdShow(claudeConfigDir) {
  const config = await loadConfig(claudeConfigDir);
  const pricesPath = getPricesPath(claudeConfigDir);
  const defaults = [
    ["BASE_MODEL", DEFAULT_BASE_MODEL],
    ["SECTIONS", DEFAULT_SECTIONS],
    ["RESETS", DEFAULT_RESETS],
    ["CONTEXT_WARN", String(DEFAULT_CONTEXT_WARN)],
    ["CONTEXT_CRIT", String(DEFAULT_CONTEXT_CRIT)],
    ["CACHE_WARN", String(DEFAULT_CACHE_WARN)],
    ["CACHE_CRIT", String(DEFAULT_CACHE_CRIT)],
    ["RESET_WARN", String(DEFAULT_RESET_WARN)],
    ["RESET_CRIT", String(DEFAULT_RESET_CRIT)],
    ["WIDTH", `${DEFAULT_WIDTH}(auto)`],
    ["MARGIN", String(DEFAULT_MARGIN)],
    ["FRESH_TOKENS", String(DEFAULT_FRESH_TOKENS)],
    ["SUMMARY_TOKENS", String(DEFAULT_SUMMARY_TOKENS)],
    ["OVERHEAD_WARN", String(DEFAULT_OVERHEAD_WARN)],
    ["OVERHEAD_CRIT", String(DEFAULT_OVERHEAD_CRIT)]
  ];
  console.log("setting         value                                    source");
  for (const [key, def] of defaults) {
    const envKey = `STATUSLINE_${key}`;
    let value;
    let source;
    if (process.env[envKey] !== void 0) {
      value = process.env[envKey];
      source = `env ${envKey}`;
    } else if (key in config) {
      value = config[key] ?? def;
      source = "saved";
    } else {
      value = def;
      source = "default";
    }
    console.log(`${key.padEnd(14)} ${value.padEnd(38)} ${source}`);
  }
  console.log(`file: ${getConfigPath(claudeConfigDir)}`);
}
async function cmdModel(claudeConfigDir, args) {
  const prices = await loadPrices(claudeConfigDir);
  const config = await loadConfig(claudeConfigDir);
  const pricesPath = getPricesPath(claudeConfigDir);
  if (args[0] === "list") {
    if (!prices.models || Object.keys(prices.models).length === 0) {
      die(`no price table yet (${pricesPath}); open a session and wait a moment, then retry`);
    }
    for (const [name, p] of Object.entries(prices.models)) {
      console.log(`${name}  (in $${p.in}/MTok)`);
    }
    return;
  }
  if (args.length === 0) {
    const v = config.BASE_MODEL;
    console.log(`base model: ${v || `${DEFAULT_BASE_MODEL} (default)`}`);
    return;
  }
  const want = args.join(" ");
  if (!prices.models || Object.keys(prices.models).length === 0) {
    die(`no price table yet (${pricesPath}); cannot validate '${want}'`);
  }
  const lowerWant = want.toLowerCase();
  let matched;
  for (const name of Object.keys(prices.models)) {
    const lowerName = name.toLowerCase();
    if (lowerName === lowerWant || lowerName === `claude ${lowerWant}`) {
      matched = name;
      break;
    }
  }
  if (!matched) {
    console.error(`error: unknown model '${want}'. Known:`);
    for (const name of Object.keys(prices.models)) {
      console.error(name);
    }
    process.exit(1);
  }
  await putSetting(claudeConfigDir, "BASE_MODEL", matched);
  console.log(`base model: ${matched}`);
}
function sectionsStatus(config) {
  const cur = currentSections(config).split(",");
  let hidden = "";
  for (const s of ALL_SECTIONS) {
    if (!cur.includes(s))
      hidden += ` ${s}`;
  }
  console.log(`enabled: ${cur.join(" ")}`);
  console.log(`hidden: ${hidden || " (none)"}`);
  console.log(`names:   ${ALL_SECTIONS.join(" ")}   (stats = always show the cache hit rate (default: only when below 80%))`);
  console.log(`change:  sections show|hide|only NAME...   or   sections all`);
}
async function saveSections(claudeConfigDir, enabled) {
  const config = await loadConfig(claudeConfigDir);
  const before = currentSections(config);
  const out = ALL_SECTIONS.filter((s) => enabled.includes(s)).join(",");
  if (!out)
    die("at least one section must stay enabled");
  await putSetting(claudeConfigDir, "SECTIONS", out);
  let hidden = "";
  for (const s of ALL_SECTIONS) {
    if (!enabled.includes(s))
      hidden += ` ${s}`;
  }
  if (before === out) {
    console.log(`no change (already: ${out})`);
  } else {
    console.log("sections updated");
  }
  console.log(`enabled: ${out.replace(/,/g, " ")}`);
  console.log(`hidden: ${hidden || " (none)"}`);
}
async function cmdSections(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  const cur = currentSections(config).split(",");
  if (args.length === 0 || args[0] === "list" || args[0] === "status") {
    sectionsStatus(config);
    return;
  }
  const sub = args[0];
  const names = args.slice(1);
  for (const n of names) {
    if (!validSection(n))
      die(`unknown section '${n}' (one of: ${ALL_SECTIONS.join(", ")})`);
  }
  switch (sub) {
    case "show":
      await saveSections(claudeConfigDir, [...cur, ...names]);
      break;
    case "only":
      await saveSections(claudeConfigDir, names);
      break;
    case "hide": {
      const remaining = cur.filter((s) => !names.includes(s));
      await saveSections(claudeConfigDir, remaining);
      break;
    }
    case "all":
      await dropSettings(claudeConfigDir, ["SECTIONS"]);
      console.log("sections: all enabled");
      break;
    default:
      die(`sections: expected show|hide|only NAME..., all or list, got '${sub}'`);
  }
}
async function cmdResets(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.RESETS;
    console.log(`resets: ${v || `${DEFAULT_RESETS} (default)`}`);
    return;
  }
  if (args.length !== 1)
    die("resets: one comma-separated list, e.g. 5h,7d,spend");
  const list = args[0];
  if (/[^A-Za-z0-9_,-]/.test(list))
    die("resets: use a comma list of window names, e.g. 5h,7d,spend");
  await putSetting(claudeConfigDir, "RESETS", list);
  console.log(`resets: ${list}`);
  console.log("only the windows named here are shown (default: 5h,7d,spend; spend exists only on gateway accounts). Undo: reset RESETS");
}
async function cmdThresholds(claudeConfigDir, args) {
  if (args.length < 3)
    die("thresholds: expected context|resets|cache|overhead WARN CRIT");
  const what = args[0];
  const warn = parseInt(args[1], 10);
  const crit = parseInt(args[2], 10);
  if (isNaN(warn) || isNaN(crit))
    die("thresholds: WARN and CRIT must be whole numbers");
  let pre;
  switch (what) {
    case "context":
      pre = "CONTEXT";
      if (!(warn < crit && crit <= 100))
        die("context: need WARN < CRIT <= 100");
      break;
    case "resets":
      pre = "RESET";
      if (!(warn < crit && crit <= 100))
        die("resets: need WARN < CRIT <= 100");
      break;
    case "cache":
      pre = "CACHE";
      if (!(crit < warn))
        die("cache: CRIT minutes must be lower than WARN (red comes later, as time runs out)");
      break;
    case "overhead":
      pre = "OVERHEAD";
      if (!(warn < crit))
        die("overhead: need WARN < CRIT (cents per call)");
      break;
    default:
      die("thresholds: expected context|resets|cache|overhead WARN CRIT");
  }
  await putSettings(claudeConfigDir, [
    [`${pre}_WARN`, String(warn)],
    [`${pre}_CRIT`, String(crit)]
  ]);
  const unit = what === "cache" ? " minutes left" : what === "overhead" ? " cents per call" : "%";
  console.log(`${what}: yellow at ${warn}, red at ${crit}${unit}`);
}
async function cmdWidth(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.WIDTH;
    console.log(`width: ${v || "auto"}`);
    return;
  }
  if (args[0] === "auto") {
    await dropSettings(claudeConfigDir, ["WIDTH"]);
    console.log("width: auto");
    return;
  }
  if (!isInt(args[0]) || parseInt(args[0], 10) <= 0)
    die("width: a positive number of columns, or auto");
  await putSetting(claudeConfigDir, "WIDTH", args[0]);
  console.log(`width: ${args[0]}`);
}
async function cmdMargin(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.MARGIN;
    console.log(`margin: ${v || `${DEFAULT_MARGIN} (default)`}`);
    return;
  }
  if (!isInt(args[0]))
    die("margin: a number of columns");
  await putSetting(claudeConfigDir, "MARGIN", args[0]);
  console.log(`margin: ${args[0]}`);
}
async function cmdOverhead(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const fresh = config.FRESH_TOKENS || String(DEFAULT_FRESH_TOKENS);
    const summary = config.SUMMARY_TOKENS || String(DEFAULT_SUMMARY_TOKENS);
    console.log(`overhead: fresh ${fresh} summary ${summary} (empty = default ${DEFAULT_FRESH_TOKENS} / ${DEFAULT_SUMMARY_TOKENS})`);
    return;
  }
  if (!isInt(args[0]) || parseInt(args[0], 10) <= 0)
    die("overhead: FRESH must be a positive token count");
  const entries = [["FRESH_TOKENS", args[0]]];
  if (args[1]) {
    if (!isInt(args[1]) || parseInt(args[1], 10) <= 0)
      die("overhead: SUMMARY must be a positive token count");
    entries.push(["SUMMARY_TOKENS", args[1]]);
  }
  await putSettings(claudeConfigDir, entries);
  console.log(`overhead: fresh ${args[0]} summary ${args[1] || "unchanged"}`);
}
async function cmdDump(claudeConfigDir, args) {
  const config = await loadConfig(claudeConfigDir);
  if (args.length === 0) {
    const v = config.DUMP;
    console.log(`dump: ${v || "off"}`);
    return;
  }
  if (args[0] === "off") {
    await dropSettings(claudeConfigDir, ["DUMP"]);
    console.log("dump: off");
    return;
  }
  await putSetting(claudeConfigDir, "DUMP", args[0]);
  console.log(`dump: ${args[0]}`);
}
async function cmdReset(claudeConfigDir, args) {
  const validKeys = [
    "BASE_MODEL",
    "SECTIONS",
    "RESETS",
    "CONTEXT_WARN",
    "CONTEXT_CRIT",
    "CACHE_WARN",
    "CACHE_CRIT",
    "RESET_WARN",
    "RESET_CRIT",
    "WIDTH",
    "MARGIN",
    "DUMP",
    "FRESH_TOKENS",
    "SUMMARY_TOKENS",
    "OVERHEAD_WARN",
    "OVERHEAD_CRIT"
  ];
  if (args.length === 0) {
    await resetAllSettings(claudeConfigDir);
    console.log("all saved settings removed");
  } else {
    for (const k of args) {
      if (!validKeys.includes(k))
        die(`invalid key: ${k}`);
    }
    await dropSettings(claudeConfigDir, args);
    console.log(`removed: ${args.join(" ")}`);
  }
}
async function runConfig(argv) {
  const claudeConfigDir = getClaudeConfigDir();
  const { command, args } = parseArgs(argv);
  switch (command) {
    case "show":
      await cmdShow(claudeConfigDir);
      break;
    case "model":
      await cmdModel(claudeConfigDir, args);
      break;
    case "sections":
      await cmdSections(claudeConfigDir, args);
      break;
    case "resets":
      await cmdResets(claudeConfigDir, args);
      break;
    case "thresholds":
      await cmdThresholds(claudeConfigDir, args);
      break;
    case "width":
      await cmdWidth(claudeConfigDir, args);
      break;
    case "margin":
      await cmdMargin(claudeConfigDir, args);
      break;
    case "overhead":
      await cmdOverhead(claudeConfigDir, args);
      break;
    case "dump":
      await cmdDump(claudeConfigDir, args);
      break;
    case "reset":
      await cmdReset(claudeConfigDir, args);
      break;
    case "help":
    case "-h":
    case "--help":
    case "":
      usage();
      break;
    default:
      usage();
      process.exit(1);
  }
}

// dist/index.js
init_refresh_prices();

// dist/install.js
import { join as join7 } from "path";
import { promises as fs5 } from "fs";
import { fileURLToPath as fileURLToPath6 } from "url";
var __filename6 = fileURLToPath6(import.meta.url);
var __dirname5 = join7(__filename6, "..");
async function copyScripts(srcDir, destDir) {
  await fs5.mkdir(destDir, { recursive: true });
  const isBundled = __filename6.includes("/bin/statusline") || __filename6.includes("\\bin\\statusline");
  if (isBundled) {
    const executable = join7(__dirname5, "statusline");
    const dest = join7(destDir, "statusline");
    try {
      await fs5.copyFile(executable, dest);
      await fs5.chmod(dest, 493);
    } catch {
      console.warn("Could not find compiled executable, skipping copy");
    }
  } else {
    const jsScripts = ["statusline.js", "config.js", "refresh-prices.js"];
    for (const script of jsScripts) {
      const src = join7(__dirname5, "..", "dist", script);
      const dest = join7(destDir, script.replace(".js", ""));
      try {
        await fs5.copyFile(src, dest);
        await fs5.chmod(dest, 493);
      } catch {
      }
    }
  }
}
async function configureSettings(claudeConfigDir, destDir, options) {
  const settingsPath = join7(claudeConfigDir, "settings.json");
  const executablePath = join7(destDir, "statusline");
  const cmd = `node ${executablePath}`;
  try {
    await fs5.access(settingsPath);
  } catch {
    await fs5.writeFile(settingsPath, "{}");
  }
  const content = await fs5.readFile(settingsPath, "utf-8");
  const settings = JSON.parse(content);
  const currentCmd = settings.statusLine?.command;
  if (currentCmd && currentCmd !== cmd && !options.force) {
    console.log(`statusLine already set to: ${currentCmd} (re-run with --force to replace)`);
    return;
  }
  settings.statusLine = {
    type: "command",
    command: cmd,
    refreshInterval: options.interval
  };
  const tmp = `${settingsPath}.${Date.now()}.tmp`;
  await fs5.writeFile(tmp, JSON.stringify(settings, null, 2));
  await fs5.rename(tmp, settingsPath);
  console.log(`statusLine set to: ${cmd} (refresh every ${options.interval}s)`);
}
async function install(options) {
  const claudeConfigDir = getClaudeConfigDir();
  const destDir = join7(claudeConfigDir, "statusline");
  const srcDir = join7(__dirname5, "..", "src");
  await copyScripts(srcDir, destDir);
  if (options.configure) {
    await configureSettings(claudeConfigDir, destDir, options);
  }
}

// dist/index.js
function parseArgs2(argv) {
  if (argv.length === 0)
    return { command: "statusline", args: [] };
  return { command: argv[0], args: argv.slice(1) };
}
async function runAgentCommand(args) {
  const subcommand = args[0] || "help";
  switch (subcommand) {
    case "list": {
      const agents = adapterRegistry.getAgentTypes();
      console.log("Available agents:");
      for (const agent of agents) {
        const adapter = adapterRegistry.get(agent);
        console.log(`  ${agent}${adapter ? "" : " (no adapter)"}`);
      }
      break;
    }
    case "detect": {
      if (args.length < 2) {
        console.error("Usage: statusline agent detect <file>");
        process.exit(1);
      }
      const filePath = args[1];
      try {
        const { readFileSync } = await import("fs");
        const input = JSON.parse(readFileSync(filePath, "utf-8"));
        const adapter = adapterRegistry.detect(input);
        if (adapter) {
          console.log(`Detected agent: ${adapter.agentType}`);
        } else {
          console.log("No matching agent detected (would fall back to claude-code)");
        }
      } catch (e) {
        console.error(`Failed to detect agent: ${e instanceof Error ? e.message : String(e)}`);
        process.exit(1);
      }
      break;
    }
    case "current": {
      const fallback = adapterRegistry.get("claude-code");
      console.log(`Current agent (fallback): ${fallback?.agentType || "claude-code"}`);
      console.log("Note: Agent is auto-detected from input JSON at runtime");
      break;
    }
    case "help":
    case "-h":
    case "--help":
    case "": {
      console.log(`Usage: statusline agent <subcommand>
  
Subcommands:
  list          List available agents
  detect <file> Detect agent from input JSON file
  current       Show current agent (fallback)`);
      break;
    }
    default: {
      console.error(`Unknown agent subcommand: ${subcommand}`);
      console.error("Run 'statusline agent help' for usage");
      process.exit(1);
    }
  }
}
async function main() {
  const argv = process.argv.slice(2);
  const { command, args } = parseArgs2(argv);
  switch (command) {
    case "statusline": {
      const chunks = [];
      for await (const chunk of process.stdin) {
        chunks.push(chunk);
      }
      const input = Buffer.concat(chunks).toString("utf-8");
      const line = await generateStatusLine(input);
      console.log(line);
      break;
    }
    case "config": {
      await runConfig(args);
      break;
    }
    case "refresh-prices": {
      const claudeConfigDir = getClaudeConfigDir();
      const ttl = parseInt(process.env.STATUSLINE_PRICES_TTL || "3600", 10);
      await refreshPrices(claudeConfigDir, ttl);
      break;
    }
    case "install": {
      let configure = false;
      let force = false;
      let interval = 15;
      for (let i = 0; i < args.length; i++) {
        switch (args[i]) {
          case "--configure":
            configure = true;
            break;
          case "--force":
            force = true;
            break;
          case "--interval":
            interval = parseInt(args[++i], 10);
            if (isNaN(interval) || interval <= 0) {
              console.error("--interval needs a positive number of seconds");
              process.exit(1);
            }
            break;
          default:
            console.error(`unknown option: ${args[i]}`);
            process.exit(1);
        }
      }
      if (configure) {
        await install({ configure, force, interval });
      }
      break;
    }
    case "agent": {
      await runAgentCommand(args);
      break;
    }
    case "help":
    case "-h":
    case "--help":
      console.log(`claude-code-status-line - TypeScript rewrite

Usage: statusline <command> [args]

Commands:
  statusline          Generate status line (reads JSON from stdin)
  config <subcommand> Manage settings
  refresh-prices      Fetch and cache model prices
  install             Install/copy scripts and optionally configure settings.json
  agent <subcommand>  Manage multi-agent support

Config subcommands:
  show                Show current settings
  model [NAME|list]   Base model for price multiplier
  sections ...        Show/hide sections
  resets LIST         Which reset windows to show
  thresholds ...      Yellow/red breakpoints
  width [N|auto]      Terminal width
  margin N            Right margin
  overhead [FRESH [SUMMARY]]  Token sizes for overhead metric
  dump [PATH|off]     Debug dump path
  reset [KEY...]      Drop saved settings

Agent subcommands:
  list                List available agents
  detect <file>       Detect agent from input JSON file
  current             Show current agent (fallback)

Install options:
  --configure         Configure settings.json
  --force             Replace existing statusLine
  --interval SECONDS  Refresh interval (default 15)

Run 'statusline config help' for detailed config help.
Run 'statusline agent help' for agent command help.`);
      break;
    default:
      console.error(`Unknown command: ${command}`);
      console.error("Run 'statusline help' for usage");
      process.exit(1);
  }
}
main().catch((err) => {
  console.error("Error:", err);
  process.exit(1);
});
