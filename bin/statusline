// packages/core/dist/priority.js
var PriorityLevel = {
  NONE: 0,
  LOW: 10,
  MEDIUM: 30,
  HIGH: 70,
  CRITICAL: 100
};
function compositePriority(sectionPriority, itemPriority) {
  return sectionPriority * 1e3 + itemPriority;
}
function parsePriority(value) {
  if (typeof value === "number") {
    const clamped = Math.max(0, Math.min(100, Math.round(value / 10) * 10));
    return clamped;
  }
  if (typeof value === "string") {
    const upper = value.toUpperCase();
    const labelToPriority = {
      NONE: 0,
      LOW: 10,
      "LOW+": 20,
      MEDIUM: 30,
      "MEDIUM+": 40,
      "MEDIUM++": 50,
      "HIGH-": 60,
      HIGH: 70,
      "HIGH+": 80,
      "CRITICAL-": 90,
      CRITICAL: 100
    };
    return labelToPriority[upper] ?? parsePriority(parseInt(upper, 10));
  }
  return 0;
}

// packages/core/dist/layout.js
var SECTION_SEPARATOR_WIDTH = 3;
var ITEM_SEPARATOR_WIDTH = 1;
function estimateWidth(item, ctx) {
  let content = "";
  if (typeof item.content === "string") {
    content = item.content;
  } else if (typeof item.content === "function") {
    content = item.content(ctx);
  } else if ("template" in item.content) {
    const { template, values, fallback } = item.content;
    try {
      content = template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? fallback ?? ""));
    } catch {
      content = fallback ?? "";
    }
  } else if ("parts" in item.content) {
    content = item.content.parts.map((p) => p.text).join("");
  }
  const stripped = content.replace(/\x1b\[[0-9;]*m/g, "");
  return stripped.length;
}
function calculateSectionOrderWidth(sections, ctx, availableWidth) {
  let width = 0;
  const sectionsWithWidth = sections.map((section) => ({
    ...section,
    items: section.items.map((item) => ({
      ...item,
      estimatedWidth: estimateWidth(item, ctx)
    }))
  }));
  for (let i = 0; i < sectionsWithWidth.length; i++) {
    const section = sectionsWithWidth[i];
    for (let j = 0; j < section.items.length; j++) {
      width += section.items[j].estimatedWidth;
      if (j > 0)
        width += ITEM_SEPARATOR_WIDTH;
    }
    if (i > 0 && section.items.length > 0) {
      const prevHasItems = sectionsWithWidth.slice(0, i).some((s) => s.items.length > 0);
      if (prevHasItems) {
        width += SECTION_SEPARATOR_WIDTH;
      }
    }
    if (width > availableWidth) {
      return { width, fits: false };
    }
  }
  return { width, fits: true };
}
function buildLayout(sections, ctx) {
  const availableWidth = ctx.width;
  const widthConstrained = ctx.widthConstrained ?? true;
  const droppedItems = [];
  const visibleSections = sections.filter((section) => !section.visibleWhen || section.visibleWhen(ctx)).map((section) => ({
    ...section,
    items: section.items.filter((item) => !item.visibleWhen || item.visibleWhen(ctx)).map((item) => ({
      ...item,
      estimatedWidth: estimateWidth(item, ctx)
    }))
  })).filter((section) => section.items.length > 0);
  const { width: totalWidth, fits: sectionOrderFits } = calculateSectionOrderWidth(visibleSections, ctx, availableWidth);
  if (!widthConstrained || sectionOrderFits) {
    return {
      sections: visibleSections.map(({ items, ...s }) => ({
        ...s,
        items: items.map(({ estimatedWidth, ...item }) => item)
      })),
      meta: {
        totalWidth,
        availableWidth,
        overflow: false,
        droppedItems: []
      }
    };
  }
  const allItems = [];
  for (const section of visibleSections) {
    for (const item of section.items) {
      allItems.push({
        sectionId: section.id,
        sectionPriority: section.priority,
        item,
        compositePriority: compositePriority(section.priority, item.priority)
      });
    }
  }
  allItems.sort((a, b) => b.compositePriority - a.compositePriority);
  const keptItems = /* @__PURE__ */ new Set();
  let usedWidth = 0;
  for (const entry of allItems) {
    const { sectionId, item, compositePriority: compositePriority2 } = entry;
    const itemKey = `${sectionId}:${item.id}`;
    let itemWidth = item.estimatedWidth;
    const sectionKeptCount = Array.from(keptItems).filter((k) => k.startsWith(`${sectionId}:`)).length;
    if (sectionKeptCount > 0) {
      itemWidth += ITEM_SEPARATOR_WIDTH;
    }
    const hasOtherSections = Array.from(keptItems).some((k) => !k.startsWith(`${sectionId}:`));
    if (sectionKeptCount === 0 && hasOtherSections) {
      itemWidth += SECTION_SEPARATOR_WIDTH;
    }
    if (usedWidth + itemWidth <= availableWidth) {
      keptItems.add(itemKey);
      usedWidth += itemWidth;
    } else {
      const isCritical = item.priority >= 100;
      if (isCritical) {
        let evictKey = null;
        let evictPriority = 100;
        for (const keptKey of keptItems) {
          const [keptSectionId, keptItemId] = keptKey.split(":");
          const keptEntry = allItems.find((e) => e.sectionId === keptSectionId && e.item.id === keptItemId);
          if (keptEntry && keptEntry.item.priority < 100) {
            if (keptEntry.item.priority < evictPriority) {
              evictPriority = keptEntry.item.priority;
              evictKey = keptKey;
            }
          }
        }
        if (evictKey) {
          keptItems.delete(evictKey);
          const [evictSectionId, evictItemId] = evictKey.split(":");
          droppedItems.push({
            sectionId: evictSectionId,
            itemId: evictItemId,
            priority: evictPriority
          });
          usedWidth = recalcUsedWidth(keptItems, allItems, availableWidth);
          keptItems.add(itemKey);
          usedWidth = recalcUsedWidth(keptItems, allItems, availableWidth);
        } else {
          droppedItems.push({
            sectionId,
            itemId: item.id,
            priority: item.priority
          });
        }
      } else {
        droppedItems.push({
          sectionId,
          itemId: item.id,
          priority: item.priority
        });
      }
    }
  }
  const layoutSections = [];
  for (const section of visibleSections) {
    const keptSectionItems = section.items.filter((item) => keptItems.has(`${section.id}:${item.id}`));
    if (section.minItems && keptSectionItems.length < section.minItems) {
      const sortedItems = [...section.items].sort((a, b) => b.priority - a.priority);
      const minItems = sortedItems.slice(0, section.minItems);
      for (const item of minItems) {
        const itemKey = `${section.id}:${item.id}`;
        if (!keptItems.has(itemKey)) {
          keptItems.add(itemKey);
          keptSectionItems.push(item);
        }
      }
    }
    if (keptSectionItems.length > 0) {
      layoutSections.push({
        ...section,
        items: keptSectionItems.map(({ estimatedWidth, ...item }) => item)
      });
    }
  }
  return {
    sections: layoutSections,
    meta: {
      totalWidth,
      availableWidth,
      overflow: droppedItems.length > 0,
      droppedItems
    }
  };
}
function recalcUsedWidth(keptItems, allItems, availableWidth) {
  let width = 0;
  const sectionCounts = /* @__PURE__ */ new Map();
  const sectionOrder = [...new Set(allItems.map((e) => e.sectionId))];
  for (let i = 0; i < sectionOrder.length; i++) {
    const sectionId = sectionOrder[i];
    const sectionItems = allItems.filter((e) => e.sectionId === sectionId);
    for (let j = 0; j < sectionItems.length; j++) {
      const itemKey = `${sectionId}:${sectionItems[j].item.id}`;
      if (keptItems.has(itemKey)) {
        width += sectionItems[j].item.estimatedWidth;
        if (j > 0)
          width += ITEM_SEPARATOR_WIDTH;
        sectionCounts.set(sectionId, (sectionCounts.get(sectionId) ?? 0) + 1);
      }
    }
    if (i > 0 && sectionCounts.get(sectionId) && sectionCounts.get(sectionId) > 0) {
      const prevHasItems = sectionOrder.slice(0, i).some((s) => (sectionCounts.get(s) ?? 0) > 0);
      if (prevHasItems) {
        width += SECTION_SEPARATOR_WIDTH;
      }
    }
  }
  return Math.min(width, availableWidth);
}

// packages/core/dist/sections/model.js
var MODEL_SECTION_ID = "model";
function renderModelName(model) {
  const RESET3 = "\x1B[0m";
  const CYAN3 = "\x1B[36m";
  const DIM3 = "\x1B[2m";
  const GREEN3 = "\x1B[32m";
  const YELLOW3 = "\x1B[33m";
  const RED3 = "\x1B[31m";
  let modelDisplay = `${CYAN3}${model.name}${RESET3}`;
  const effortLevel = model.effort;
  let effortDisplay = "";
  switch (effortLevel) {
    case "low":
      effortDisplay = `${DIM3}lo${RESET3}`;
      break;
    case "medium":
      effortDisplay = `${GREEN3}med${RESET3}`;
      break;
    case "high":
      effortDisplay = `${YELLOW3}hi${RESET3}`;
      break;
    case "xhigh":
      effortDisplay = `${RED3}xhi${RESET3}`;
      break;
    case "max":
      effortDisplay = `${RED3}max${RESET3}`;
      break;
    default:
      if (effortLevel)
        effortDisplay = `${DIM3}${effortLevel}${RESET3}`;
  }
  return `${modelDisplay}${effortDisplay ? ` ${effortDisplay}` : ""}`;
}
var modelSection = {
  id: MODEL_SECTION_ID,
  name: "Model",
  priority: PriorityLevel.CRITICAL,
  items: [],
  // Populated dynamically
  visibleWhen: (ctx) => !!ctx.input?.model,
  minItems: 1
};
function createModelSection(ctx) {
  const model = ctx.input.model;
  if (!model)
    return { ...modelSection, items: [] };
  const items = [];
  if (model.name) {
    items.push({
      id: "name",
      content: (ctx2) => renderModelName(ctx2.input.model),
      priority: PriorityLevel.CRITICAL,
      minWidth: 3,
      idealWidth: 30,
      hints: { truncatable: true, truncateSuffix: "\u2026" }
    });
  }
  if (model.costMultiplier !== void 0 && model.costMultiplier !== 1 && model.costMultiplier !== null) {
    items.push({
      id: "costMultiplier",
      content: (ctx2) => `\x1B[36m${model.name}\x1B[0m \x1B[2mx${model.costMultiplier.toFixed(1).replace(/\.0$/, "")}\x1B[0m`,
      priority: PriorityLevel.LOW,
      minWidth: 6,
      idealWidth: 12,
      hints: { truncatable: false }
    });
  }
  return {
    ...modelSection,
    items
  };
}

// packages/core/dist/sections/context.js
var BLOCK_CHARS3 = ["\u2581", "\u2582", "\u2583", "\u2584", "\u2585", "\u2586", "\u2587", "\u2588"];
var LEFT_BORDER3 = "\u2595";
var RIGHT_BORDER3 = "\u258F";
var CONTEXT_WARN = 50;
var CONTEXT_CRIT = 80;
var CONTEXT_SECTION_ID = "context";
function createContextItems(input) {
  const context = input.context;
  if (!context)
    return [];
  const items = [];
  if (context.percentage !== void 0) {
    items.push({
      id: "bar",
      content: (ctx) => renderContextBar(ctx.input.context, ctx.config),
      priority: PriorityLevel.HIGH,
      minWidth: 10,
      idealWidth: 20,
      hints: { truncatable: false }
    });
  }
  return items;
}
function renderContextBar(context, config) {
  const pct = Math.min(100, Math.max(0, context.percentage ?? 0));
  const width = 8;
  const blockIdx = Math.min(Math.floor(pct / 12.5), 7);
  const fill = BLOCK_CHARS3[blockIdx];
  const warn = config?.contextWarn ?? CONTEXT_WARN;
  const crit = config?.contextCrit ?? CONTEXT_CRIT;
  let color = "\x1B[32m";
  if (pct >= crit)
    color = "\x1B[31m";
  else if (pct >= warn)
    color = "\x1B[33m";
  const RESET3 = "\x1B[0m";
  const ctxChar = `${color}${LEFT_BORDER3}${fill}${RIGHT_BORDER3}${RESET3}`;
  const ctxPct = `${color}${Math.round(pct)}%${RESET3}`;
  const sizeStr = context.tokensTotal ? `${"\x1B[2m"}/${formatNumber(context.tokensTotal)}${RESET3}` : "";
  return `${ctxChar} ${ctxPct}${sizeStr}`;
}
function formatNumber(n) {
  if (n >= 1e6)
    return Math.floor(n / 1e6) + "M";
  if (n >= 1e3)
    return Math.floor(n / 1e3) + "k";
  return String(n);
}
