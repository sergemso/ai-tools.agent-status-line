// src/shared/prices.ts
import { promises as fs2 } from "fs";
import { join as join2, dirname as dirname2 } from "path";
import { fileURLToPath as fileURLToPath2 } from "url";
function getPricesPath(claudeConfigDir) {
  return join2(claudeConfigDir, "model-prices.json");
}
async function loadPrices(claudeConfigDir, ttl = DEFAULT_PRICES_TTL) {
  const path = getPricesPath(claudeConfigDir);
  const now = Date.now();
  if (pricesCache && now - pricesCache.mtime < ttl * 1e3) {
    return pricesCache.table;
  }
  try {
    const stat = await fs2.stat(path);
    if (now - stat.mtimeMs < ttl * 1e3) {
      const content = await fs2.readFile(path, "utf-8");
      const table = JSON.parse(content);
      pricesCache = { table, mtime: stat.mtimeMs };
      return table;
    }
  } catch {
  }
  return { models: {} };
}
async function savePrices(claudeConfigDir, table) {
  const path = getPricesPath(claudeConfigDir);
  await ensureDir2(dirname2(path));
  const tmp = `${path}.${Date.now()}.${Math.random().toString(36).slice(2)}`;
  await fs2.writeFile(tmp, JSON.stringify({ models: table.models }), { mode: 420 });
  await fs2.rename(tmp, path);
  const stat = await fs2.stat(path);
  pricesCache = { table, mtime: stat.mtimeMs };
}
function matchModelPrice(table, modelName, baseModel, fastMode) {
  const models = table.models;
  const base = models[baseModel]?.in;
  if (!base || base === 0)
    return null;
  const candidates = [
    modelName,
    `Claude ${modelName}`,
    modelName.toLowerCase(),
    `claude ${modelName.toLowerCase()}`
  ];
  let matched;
  for (const c of candidates) {
    if (models[c]) {
      matched = models[c];
      break;
    }
  }
  if (!matched)
    return null;
  const inputPrice = fastMode && matched.fast_in ? matched.fast_in : matched.in;
  const multiplier = inputPrice / base * 10;
  return Math.round(multiplier) / 10;
}
async function ensureDir2(dir) {
  try {
    await fs2.mkdir(dir, { recursive: true });
  } catch {
  }
}
var __filename2, __dirname2, pricesCache;
