// packages/core/dist/sections/cache.js
var CACHE_WARN = 20;
var CACHE_CRIT = 5;
var CACHE_SECTION_ID = "cache";
function createCacheItems(input) {
  const cache = input.cache;
  if (!cache)
    return [];
  const items = [];
  if (cache.status === "warm" && cache.expiresAt !== void 0) {
    items.push({
      id: "timer",
      content: (ctx) => renderCacheTimer(ctx.input.cache, ctx.config),
      priority: PriorityLevel.MEDIUM,
      minWidth: 4,
      idealWidth: 15,
      hints: { truncatable: false }
    });
  } else if (cache.status === "cold") {
    items.push({
      id: "cold",
      content: (ctx) => renderColdCache(ctx.input.cache),
      priority: PriorityLevel.HIGH,
      minWidth: 8,
      idealWidth: 15,
      hints: { truncatable: false }
    });
  }
  return items;
}
function renderCacheTimer(cache, config) {
  const now = Math.floor(Date.now() / 1e3);
  const rem = cache.expiresAt - now;
  if (rem <= 0) {
    return renderColdCache(cache);
  }
  const warn = (config?.cacheWarn ?? CACHE_WARN) * 60;
  const crit = (config?.cacheCrit ?? CACHE_CRIT) * 60;
  let color = "\x1B[32m";
  if (rem < crit)
    color = "\x1B[31m";
  else if (rem < warn)
    color = "\x1B[33m";
  const remMinutes = rem >= 60 ? Math.floor(rem / 60) * 60 : rem;
  const formatted = formatDuration(remMinutes).replace(/ /g, "");
  let hitRatioStr = "";
  if (cache.hitRatio !== void 0) {
    const pct = Math.round(cache.hitRatio * 100);
    const hrColor = pct < 80 ? "\x1B[31m" : "\x1B[32m";
    hitRatioStr = ` ${hrColor}${pct}%\x1B[0m`;
  }
  return `\x1B[2m\u23F1\x1B[0m ${color}${formatted}\x1B[0m${hitRatioStr}`;
}
function renderColdCache(cache) {
  let hitRatioStr = "";
  if (cache.hitRatio !== void 0) {
    const pct = Math.round(cache.hitRatio * 100);
    const hrColor = pct < 80 ? "\x1B[31m" : "\x1B[32m";
    hitRatioStr = ` ${hrColor}${pct}%\x1B[0m`;
  }
  return `\x1B[31m\u23F1 cold\x1B[0m${hitRatioStr}`;
}
function formatDuration(seconds) {
  if (seconds >= 3600) {
    const hours = Math.floor(seconds / 3600);
    const mins = Math.floor(seconds % 3600 / 60);
    return `${hours}h${mins > 0 ? mins + "m" : ""}`;
  }
  if (seconds >= 60) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}m${secs > 0 ? secs + "s" : ""}`;
  }
  return `${seconds}s`;
}
var cacheSection = {
  id: CACHE_SECTION_ID,
  name: "Cache",
  priority: PriorityLevel.MEDIUM,
  items: [],
  visibleWhen: (ctx) => !!ctx.input?.cache,
  minItems: 0
};
function createCacheSection(ctx) {
  return {
    ...cacheSection,
    items: createCacheItems(ctx.input)
  };
}

// packages/core/dist/sections/rate-limits.js
var WINDOW_ALIASES = {
  "5h": { alias: "5h", name: "", total: "100" },
  "7d": { alias: "7d", name: "", total: "100" },
  spend: { alias: "spend", name: "Spend limit", total: "100" },
  "1d": { alias: "1d", name: "", total: "100" }
};
var RATE_LIMITS_SECTION_ID = "rate-limits";
function createRateLimitsItems(input, config) {
  const rateLimits = input.rateLimits;
  if (!rateLimits || !Array.isArray(rateLimits) || rateLimits.length === 0) {
    return [];
  }
  const resetsFilter = config?.sections?.["rate-limits"]?.resets;
  let filteredLimits = rateLimits;
  if (resetsFilter && Array.isArray(resetsFilter) && resetsFilter.length > 0) {
    filteredLimits = rateLimits.filter((r) => resetsFilter.includes(r.window));
  }
  const items = [];
  for (const limit of filteredLimits) {
    if (!limit.window || limit.remaining === void 0)
      continue;
    const alias = WINDOW_ALIASES[limit.window]?.alias ?? limit.window;
    const name = WINDOW_ALIASES[limit.window]?.name ?? "";
    const total = WINDOW_ALIASES[limit.window]?.total ?? "";
    const used = limit.limit - limit.remaining;
    const pct = limit.limit > 0 ? used / limit.limit * 100 : 0;
    const priority = pct >= 80 ? PriorityLevel.HIGH : pct >= 50 ? PriorityLevel.MEDIUM : PriorityLevel.LOW;
    items.push({
      id: `window-${limit.window}`,
      content: (ctx) => renderRateLimit(limit, ctx.config),
      priority,
      minWidth: 8,
      idealWidth: 25,
      hints: { truncatable: true, truncateSuffix: "\u2026" }
    });
  }
  return items;
}
function renderRateLimit(limit, config) {
  const alias = WINDOW_ALIASES[limit.window]?.alias ?? limit.window;
  const name = WINDOW_ALIASES[limit.window]?.name ?? "";
  const used = limit.limit - limit.remaining;
  const pct = limit.limit > 0 ? Math.round(used / limit.limit * 100) : 0;
  const remaining = limit.remaining;
  const lmt = limit.limit;
  const warn = config?.resetWarn ?? 50;
  const crit = config?.resetCrit ?? 80;
  let pctColor = "\x1B[32m";
  if (pct >= crit)
    pctColor = "\x1B[31m";
  else if (pct >= warn)
    pctColor = "\x1B[33m";
  const now = Math.floor(Date.now() / 1e3);
  const resetsAt = limit.resetsAt ?? 0;
  const left = resetsAt - now;
  const timeLeft = formatDuration2(left);
  const totPart = ` \x1B[2m/ ${lmt}\x1B[0m`;
  let namePart = "";
  if (name)
    namePart = `\x1B[2m${name}\x1B[0m `;
  let pctPart = `${pctColor}${pct}%\x1B[0m `;
  return `${namePart}\x1B[2m${alias}\x1B[0m ${pctPart}${timeLeft}${totPart}`;
}
function formatDuration2(seconds) {
  if (seconds <= 0)
    return "0s";
  if (seconds >= 86400) {
    const days = Math.floor(seconds / 86400);
    const hours = Math.floor(seconds % 86400 / 3600);
    return `${days}d${hours > 0 ? hours + "h" : ""}`;
  }
  if (seconds >= 3600) {
    const hours = Math.floor(seconds / 3600);
    const mins = Math.floor(seconds % 3600 / 60);
    return `${hours}h${mins > 0 ? mins + "m" : ""}`;
  }
  if (seconds >= 60) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}m${secs > 0 ? secs + "s" : ""}`;
  }
  return `${seconds}s`;
}
var rateLimitsSection = {
  id: RATE_LIMITS_SECTION_ID,
  name: "Rate Limits",
  priority: PriorityLevel.MEDIUM,
  items: [],
  visibleWhen: (ctx) => Array.isArray(ctx.input?.rateLimits) && ctx.input.rateLimits.length > 0,
  minItems: 0
};
function createRateLimitsSection(ctx) {
  return {
    ...rateLimitsSection,
    items: createRateLimitsItems(ctx.input, ctx.config)
  };
}

