{
  "name": "@statusline/opencode-plugin",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin rendering a @statusline/core status line",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./src/plugin.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "statusline",
    "tui",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@statusline/core": "^1.0.0"
  },
  "peerDependencies": {
    "@opencode/client": ">=2.0.0",
    "@opencode/plugin": ">=2.0.0",
    "@opentui/solid": ">=1.0.0",
    "solid-js": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^1.9.17",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
