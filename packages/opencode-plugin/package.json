{
  "name": "@statusline/opencode-plugin",
  "version": "1.0.2",
  "description": "OpenCode TUI plugin rendering a @statusline/core status line",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugin": {
      "import": "./src/plugin.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "statusline",
    "tui",
    "plugin"
  ],
  "author": "S. Strebulaev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergemso/ai-tools.agent-status-line.git",
    "directory": "packages/opencode-plugin"
  },
  "bugs": {
    "url": "https://github.com/sergemso/ai-tools.agent-status-line/issues"
  },
  "homepage": "https://github.com/sergemso/ai-tools.agent-status-line/tree/main/packages/opencode-plugin#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "README.md",
    "src/plugin.tsx"
  ],
  "dependencies": {
    "@statusline/core": "^1.0.0"
  },
  "peerDependencies": {
    "@opencode/client": "*",
    "@opencode/plugin": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode/client": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
