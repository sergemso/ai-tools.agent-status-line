{
  "name": "@statusline/opencode-plugin",
  "version": "1.1.2",
  "description": "OpenCode TUI plugin rendering a @statusline/core status line",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "statusline",
    "tui",
    "plugin"
  ],
  "author": "S. Strebulaev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergemso/ai-tools.agent-status-line.git",
    "directory": "packages/opencode-plugin"
  },
  "bugs": {
    "url": "https://github.com/sergemso/ai-tools.agent-status-line/issues"
  },
  "homepage": "https://github.com/sergemso/ai-tools.agent-status-line/tree/main/packages/opencode-plugin#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@statusline/core": "^1.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.0",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.1.4",
    "@opencode/theme": "2.1.4",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/node": "^20.10.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "1.9.12",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
