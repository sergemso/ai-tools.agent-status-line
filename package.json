{
  "name": "claude-code-status-line",
  "version": "1.0.6",
  "description": "Claude Code status line plugin - TypeScript rewrite",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "statusline": "bin/statusline"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && esbuild dist/index.js --bundle --platform=node --target=node18 --format=esm --outfile=bin/statusline --external:fs --external:path --external:child_process --external:os --external:crypto --banner:js=\"#!/usr/bin/env node\"",
    "build:bun": "bun build src/index.ts --compile --outfile bin/statusline",
    "build:core": "npm run build --workspace=@statusline/core",
    "build:opencode": "npm run build --workspace=@statusline/opencode-plugin",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "status-line",
    "plugin"
  ],
  "author": "S. Strebulaev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergemso/ai-tools.agent-status-line.git"
  },
  "bugs": {
    "url": "https://github.com/sergemso/ai-tools.agent-status-line/issues"
  },
  "homepage": "https://github.com/sergemso/ai-tools.agent-status-line#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@statusline/core": "^1.0.0",
    "@statusline/opencode-plugin": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "workspaces": [
    "packages/*"
  ]
}
